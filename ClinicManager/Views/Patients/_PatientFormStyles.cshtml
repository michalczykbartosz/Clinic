<style>
    *, *::before, *::after { box-sizing: border-box; }
    .form-wrapper { max-width: 760px; margin: 2.5rem auto; padding: 0 1rem; font-family: 'Inter', system-ui, -apple-system, sans-serif; color: #1E293B; }
    .page-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.75rem; flex-wrap: wrap; }
    .page-header__left { display: flex; align-items: center; gap: 1rem; }
    .page-header__icon { width: 48px; height: 48px; background: #EFF6FF; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #2563EB; flex-shrink: 0; }
    .page-header__icon svg { width: 23px; height: 23px; }
    .page-header__title { font-size: 1.5rem; font-weight: 700; color: #0F172A; margin: 0 0 .15rem; letter-spacing: -.02em; }
    .page-header__sub { font-size: .85rem; color: #64748B; margin: 0; }
    .form-card { background: #fff; border: 1px solid #E2E8F0; border-radius: 16px; padding: 2rem 2.25rem; box-shadow: 0 1px 3px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.04); }
    .form-section { margin-bottom: 2rem; }
    .form-section__title { display: flex; align-items: center; gap: .65rem; font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; color: #94A3B8; margin: 0 0 1.25rem; }
    .form-section__number { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; background: #F1F5F9; border-radius: 6px; font-size: .72rem; color: #475569; font-weight: 700; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.25rem; }
    .form-grid--three { grid-template-columns: repeat(3, 1fr); margin-bottom: 0; }
    .form-group { display: flex; flex-direction: column; gap: .4rem; }
    .form-label { font-size: .82rem; font-weight: 600; color: #374151; }
    .form-control { width: 100%; padding: .6rem .85rem; font-size: .9rem; color: #1E293B; background: #FAFAFA; border: 1.5px solid #D1D5DB; border-radius: 9px; transition: border-color .18s, box-shadow .18s; outline: none; }
    .form-control:focus { border-color: #3B82F6; background: #fff; box-shadow: 0 0 0 3px rgba(59,130,246,.15); }
    .field-error { font-size: .78rem; color: #DC2626; font-weight: 500; }
    .alert { padding: .85rem 1rem; border-radius: 9px; font-size: .875rem; margin-bottom: 1.5rem; }
    .alert-danger { background: #FEF2F2; border: 1px solid #FECACA; color: #991B1B; }
    .alert:empty { display: none; }
    .form-actions { display: flex; align-items: center; gap: .75rem; padding-top: 1.5rem; border-top: 1px solid #F1F5F9; margin-top: 2rem; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; padding: .65rem 1.5rem; font-size: .875rem; font-weight: 600; border-radius: 9px; border: 1.5px solid transparent; cursor: pointer; text-decoration: none; transition: all .18s; font-family: inherit; white-space: nowrap; }
    .btn-primary { background: #2563EB; color: #fff; border-color: #2563EB; }
    .btn-primary:hover { background: #1D4ED8; border-color: #1D4ED8; box-shadow: 0 4px 12px rgba(37,99,235,.35); transform: translateY(-1px); }
    .btn-secondary { background: #fff; color: #475569; border-color: #D1D5DB; }
    .btn-secondary:hover { background: #F8FAFC; border-color: #94A3B8; }
    @@media (max-width: 640px) {
        .form-grid, .form-grid--three { grid-template-columns: 1fr; }
        .form-card { padding: 1.5rem 1.25rem; }
        .form-actions { align-items: stretch; flex-direction: column; }
    }
</style>
