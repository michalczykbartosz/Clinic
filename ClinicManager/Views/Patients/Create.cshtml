@model ClinicManager.DTOs.UpsertPatientDto

@{
    ViewData["Title"] = "Dodaj pacjenta";
}

<h1 class="h3 mb-3">Dodaj pacjenta</h1>

<form asp-action="Create" method="post" class="row g-3">
    <partial name="_PatientForm" model="Model" />

    <div class="col-12 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Zapisz</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Anuluj</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
