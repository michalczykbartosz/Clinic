@model ClinicManager.DTOs.UpdatePatientRecordDto

@{
    ViewData["Title"] = "Kartoteka pacjenta";
    var patientId = ViewData["PatientId"];
    var patientFullName = ViewData["PatientFullName"] as string ?? "pacjenta";
}

<div class="form-wrapper">
    <div class="page-header">
        <div class="page-header__left">
            <div class="page-header__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                    <polyline points="10 9 9 9 8 9"/>
                </svg>
            </div>
            <div>
                <h1 class="page-header__title">Kartoteka pacjenta</h1>
                <p class="page-header__sub">@patientFullName</p>
            </div>
        </div>
        <a asp-action="Details" asp-route-id="@patientId" class="btn btn-secondary">Powrót</a>
    </div>

    <div class="form-card">
        <form asp-action="Record" asp-route-id="@patientId" method="post">
            <div class="form-section">
                <h2 class="form-section__title"><span class="form-section__number">01</span>Dane identyfikacyjne</h2>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="PESEL" class="form-label">PESEL</label>
                        <input asp-for="PESEL" class="form-control" inputmode="numeric" maxlength="11" autocomplete="off" />
                        <span asp-validation-for="PESEL" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="InsuranceNumber" class="form-label">Numer ubezpieczenia</label>
                        <input asp-for="InsuranceNumber" class="form-control" maxlength="40" autocomplete="off" />
                        <span asp-validation-for="InsuranceNumber" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Zapisz kartotekę</button>
                <a class="btn btn-secondary" asp-action="Details" asp-route-id="@patientId">Anuluj</a>
            </div>
        </form>
    </div>
</div>

<partial name="_PatientFormStyles" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
