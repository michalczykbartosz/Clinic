@model ClinicManager.DTOs.UpsertPatientDto

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div class="col-md-6">
    <label asp-for="FirstName" class="form-label"></label>
    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
    <span asp-validation-for="FirstName" class="text-danger"></span>
</div>

<div class="col-md-6">
    <label asp-for="LastName" class="form-label"></label>
    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
    <span asp-validation-for="LastName" class="text-danger"></span>
</div>

<div class="col-md-4">
    <label asp-for="PESEL" class="form-label"></label>
    <input asp-for="PESEL" class="form-control" inputmode="numeric" maxlength="11" />
    <span asp-validation-for="PESEL" class="text-danger"></span>
</div>

<div class="col-md-4">
    <label asp-for="InsuranceNumber" class="form-label"></label>
    <input asp-for="InsuranceNumber" class="form-control" />
    <span asp-validation-for="InsuranceNumber" class="text-danger"></span>
</div>

<div class="col-md-4">
    <label asp-for="BirthDate" class="form-label"></label>
    <input asp-for="BirthDate" class="form-control" type="date" />
    <span asp-validation-for="BirthDate" class="text-danger"></span>
</div>
