@using ClinicManager.Models
@model ClinicManager.ViewModels.PatientDetailsViewModel

@{
    ViewData["Title"] = "Szczegóły pacjenta";
    var canManagePatients = User.IsInRole("Admin") || User.IsInRole("Rejestratorka");
    var canManageDocuments = User.IsInRole("Admin") || User.IsInRole("Rejestratorka") || User.IsInRole("Lekarz");
}

@functions {
    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024)
        {
            return $"{bytes} B";
        }

        var kilobytes = bytes / 1024d;
        if (kilobytes < 1024)
        {
            return $"{kilobytes:0.#} KB";
        }

        return $"{kilobytes / 1024d:0.#} MB";
    }

    private static string GetVisitStatusLabel(VisitState status)
    {
        return status switch
        {
            VisitState.Planned => "Zaplanowana",
            VisitState.InProgress => "W trakcie",
            VisitState.Finished => "Zakończona",
            VisitState.Canceled => "Anulowana",
            _ => status.ToString()
        };
    }

    private static string GetVisitStatusBadgeClass(VisitState status)
    {
        return status switch
        {
            VisitState.Planned => "status-badge--planned",
            VisitState.InProgress => "status-badge--progress",
            VisitState.Finished => "status-badge--finished",
            VisitState.Canceled => "status-badge--canceled",
            _ => "status-badge--default"
        };
    }
}

<div class="page-wrapper">
    <div class="page-header">
        <div class="page-header__left">
            <div class="page-header__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </div>
            <div>
                <h1 class="page-header__title">@Model.Patient.FirstName @Model.Patient.LastName</h1>
                <p class="page-header__sub">Szczegóły pacjenta i historia wizyt</p>
            </div>
        </div>
        <div class="header-actions">
            <a class="btn btn-secondary" asp-action="Index">Powrót</a>
            @if (canManagePatients)
            {
                <a class="btn btn-secondary" asp-action="Record" asp-route-id="@Model.Patient.PatientId">Kartoteka</a>
                <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Patient.PatientId">Edytuj</a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <div class="details-card">
        <div class="details-grid">
            <div class="detail-item">
                <span class="detail-label">Imię</span>
                <strong>@Model.Patient.FirstName</strong>
            </div>
            <div class="detail-item">
                <span class="detail-label">Nazwisko</span>
                <strong>@Model.Patient.LastName</strong>
            </div>
            <div class="detail-item">
                <span class="detail-label">PESEL</span>
                <strong>@Model.Patient.PESEL</strong>
            </div>
            <div class="detail-item">
                <span class="detail-label">Numer ubezpieczenia</span>
                <strong>@Model.Patient.InsuranceNumber</strong>
            </div>
            <div class="detail-item">
                <span class="detail-label">Data urodzenia</span>
                <strong>@Model.Patient.BirthDate.ToString("dd.MM.yyyy")</strong>
            </div>
        </div>
    </div>

    <div class="section-header">
        <h2>Dokumenty pacjenta</h2>
        <span>@Model.Documents.Count plików</span>
    </div>

    <div class="documents-card">
        @if (canManageDocuments)
        {
            <form asp-controller="PatientDocuments"
                  asp-action="Upload"
                  method="post"
                  enctype="multipart/form-data"
                  class="document-upload">
                <input type="hidden" name="PatientId" value="@Model.Patient.PatientId" />
                <input class="file-input"
                       type="file"
                       name="File"
                       accept=".pdf,.jpg,.jpeg,.png,application/pdf,image/jpeg,image/png"
                       required />
                <button class="btn btn-primary" type="submit">Dodaj dokument</button>
            </form>
        }

        @if (Model.Documents.Count == 0)
        {
            <div class="empty-state empty-state--compact">
                <p>Pacjent nie ma jeszcze dodanych dokumentów.</p>
            </div>
        }
        else
        {
            <div class="table-scroll">
                <table class="data-table documents-table">
                    <thead>
                    <tr>
                        <th>Nazwa pliku</th>
                        <th>Typ</th>
                        <th>Rozmiar</th>
                        <th>Dodano</th>
                        <th class="th-action">Obsługa</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var document in Model.Documents)
                    {
                        <tr>
                            <td>@document.OriginalFileName</td>
                            <td class="cell--muted">@document.ContentType</td>
                            <td>@FormatFileSize(document.FileSize)</td>
                            <td class="cell--date">@document.UploadedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td class="td-action">
                                <a class="btn-mini btn-mini--secondary"
                                   asp-controller="PatientDocuments"
                                   asp-action="Download"
                                   asp-route-id="@document.PatientDocumentId">
                                    Pobierz
                                </a>
                                @if (canManageDocuments)
                                {
                                    <form asp-controller="PatientDocuments"
                                          asp-action="Delete"
                                          asp-route-id="@document.PatientDocumentId"
                                          method="post"
                                          class="inline-form">
                                        <button class="btn-mini btn-mini--danger" type="submit">Usuń</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="section-header">
        <h2>Wizyty pacjenta</h2>
        <span>@Model.Visits.Count wpisów</span>
    </div>

    @if (Model.Visits.Count == 0)
    {
        <div class="empty-state">
            <p>Pacjent nie ma jeszcze zarejestrowanych wizyt.</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Numer</th>
                        <th>Data i godzina</th>
                        <th>Status</th>
                        <th>Lekarz</th>
                        <th>Specjalizacja</th>
                        <th class="th-action">Obsługa</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var visit in Model.Visits)
                    {
                        <tr>
                            <td><span class="id-chip">#@visit.VisitId</span></td>
                            <td class="cell--date">@visit.VisitDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <span class="status-badge @GetVisitStatusBadgeClass(visit.VisitStatus)">
                                    @GetVisitStatusLabel(visit.VisitStatus)
                                </span>
                            </td>
                            <td>@visit.DoctorFullName</td>
                            <td class="cell--muted">@visit.DoctorSpecialization</td>
                            <td class="td-action">
                                <a class="btn-mini btn-mini--secondary"
                                   asp-controller="Procedures"
                                   asp-action="Index"
                                   asp-route-visitId="@visit.VisitId">
                                    Procedury
                                </a>
                                <a class="btn-mini btn-mini--secondary"
                                   asp-controller="VisitMedications"
                                   asp-action="Index"
                                   asp-route-visitId="@visit.VisitId">
                                    Leki
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (canManagePatients)
    {
        <div class="danger-actions">
            <a class="btn-mini btn-mini--danger" asp-action="Delete" asp-route-id="@Model.Patient.PatientId">Usuń pacjenta</a>
        </div>
    }
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; }
    .page-wrapper { max-width: 1080px; margin: 2.5rem auto; padding: 0 1rem; font-family: 'Inter', system-ui, -apple-system, sans-serif; color: #1E293B; }
    .page-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .page-header__left, .header-actions { display: flex; align-items: center; gap: 1rem; }
    .header-actions { gap: .6rem; }
    .page-header__icon { width: 48px; height: 48px; background: #EFF6FF; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #2563EB; flex-shrink: 0; }
    .page-header__icon svg { width: 22px; height: 22px; }
    .page-header__title { font-size: 1.5rem; font-weight: 700; color: #0F172A; margin: 0 0 .15rem; letter-spacing: -.02em; }
    .page-header__sub { font-size: .82rem; color: #94A3B8; margin: 0; }
    .alert { padding: .8rem 1.1rem; border-radius: 10px; font-size: .875rem; margin-bottom: 1.25rem; }
    .alert-success { background: #F0FDF4; border: 1px solid #BBF7D0; color: #166534; }
    .alert-danger { background: #FEF2F2; border: 1px solid #FECACA; color: #991B1B; }
    .details-card, .table-card, .documents-card { background: #fff; border: 1px solid #E2E8F0; border-radius: 14px; box-shadow: 0 1px 3px rgba(0,0,0,.05); }
    .details-card { padding: 1.25rem; margin-bottom: 1.75rem; }
    .documents-card { margin-bottom: 1.75rem; overflow: hidden; }
    .document-upload { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: .75rem; padding: 1rem; border-bottom: 1px solid #E2E8F0; background: #F8FAFC; }
    .file-input { width: 100%; min-width: 0; font-size: .84rem; color: #475569; border: 1.5px solid #D1D5DB; border-radius: 9px; background: #fff; padding: .5rem .7rem; }
    .documents-table td:first-child { max-width: 320px; overflow-wrap: anywhere; white-space: normal; }
    .inline-form { display: inline-flex; margin-left: .35rem; }
    .details-grid { display: grid; grid-template-columns: repeat(5, minmax(130px, 1fr)); gap: .75rem; }
    .detail-item { background: #F8FAFC; border: 1px solid #EEF2F7; border-radius: 10px; padding: .85rem; }
    .detail-label { display: block; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #94A3B8; margin-bottom: .35rem; }
    .detail-item strong { color: #0F172A; font-size: .92rem; }
    .section-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: .9rem; }
    .section-header h2 { font-size: 1rem; font-weight: 700; color: #0F172A; margin: 0; }
    .section-header span { font-size: .78rem; color: #94A3B8; }
    .empty-state { padding: 2.5rem 2rem; background: #fff; border: 1px dashed #D1D5DB; border-radius: 14px; color: #94A3B8; text-align: center; }
    .empty-state--compact { border: 0; border-radius: 0; padding: 1.5rem; }
    .empty-state p { margin: 0; }
    .table-card { overflow: hidden; }
    .table-scroll { overflow-x: auto; }
    .data-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .data-table thead tr { background: #F8FAFC; }
    .data-table th { padding: .75rem 1.1rem; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #64748B; text-align: left; border-bottom: 1px solid #E2E8F0; white-space: nowrap; }
    .data-table td { padding: .85rem 1.1rem; border-bottom: 1px solid #F1F5F9; vertical-align: middle; white-space: nowrap; }
    .data-table tbody tr:last-child td { border-bottom: none; }
    .data-table tbody tr:hover { background: #FAFBFF; }
    .th-action, .td-action { text-align: right; }
    .td-action .btn-mini + .btn-mini { margin-left: .35rem; }
    .id-chip { display: inline-block; font-size: .74rem; font-weight: 600; color: #64748B; background: #F1F5F9; border-radius: 6px; padding: .2rem .55rem; font-variant-numeric: tabular-nums; }
    .cell--date { font-variant-numeric: tabular-nums; color: #475569; }
    .cell--muted { color: #94A3B8; }
    .status-badge { display: inline-block; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; border-radius: 20px; padding: .25rem .7rem; white-space: nowrap; }
    .status-badge--planned { background: #DBEAFE; color: #1D4ED8; }
    .status-badge--progress { background: #FEF3C7; color: #92400E; }
    .status-badge--finished { background: #D1FAE5; color: #065F46; }
    .status-badge--canceled, .status-badge--default { background: #F1F5F9; color: #64748B; }
    .danger-actions { display: flex; justify-content: flex-end; margin-top: 1rem; }
    .btn, .btn-mini { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; font-weight: 600; border: 1.5px solid transparent; cursor: pointer; text-decoration: none; transition: all .18s; font-family: inherit; white-space: nowrap; }
    .btn { padding: .6rem 1.3rem; font-size: .875rem; border-radius: 9px; }
    .btn-mini { padding: .4rem .8rem; font-size: .78rem; border-radius: 7px; }
    .btn-primary { background: #2563EB; color: #fff; border-color: #2563EB; }
    .btn-primary:hover { background: #1D4ED8; border-color: #1D4ED8; box-shadow: 0 4px 12px rgba(37,99,235,.3); transform: translateY(-1px); }
    .btn-secondary, .btn-mini--secondary { background: #fff; color: #475569; border-color: #D1D5DB; }
    .btn-secondary:hover, .btn-mini--secondary:hover { background: #F8FAFC; border-color: #94A3B8; }
    .btn-mini--danger { background: #FEF2F2; color: #DC2626; border-color: #FECACA; }
    .btn-mini--danger:hover { background: #DC2626; color: #fff; border-color: #DC2626; }
    @@media (max-width: 820px) { .details-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 560px) {
        .details-grid { grid-template-columns: 1fr; }
        .document-upload { grid-template-columns: 1fr; }
        .header-actions { width: 100%; }
        .header-actions .btn { flex: 1; }
    }
</style>
