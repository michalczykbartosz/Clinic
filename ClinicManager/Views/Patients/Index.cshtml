@model IReadOnlyList<ClinicManager.DTOs.PatientDto>

@{
    ViewData["Title"] = "Pacjenci";
    var query = ViewData["Query"] as string ?? string.Empty;
    var isSearchActive = !string.IsNullOrWhiteSpace(query);
    var canManagePatients = User.IsInRole("Admin") || User.IsInRole("Rejestratorka");
}

<div class="page-wrapper">
    <div class="page-header">
        <div class="page-header__left">
            <div class="page-header__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
            </div>
            <div>
                <h1 class="page-header__title">Pacjenci</h1>
                <p class="page-header__sub">@Model.Count pacjentów w systemie</p>
            </div>
        </div>
        @if (canManagePatients)
        {
            <a class="btn btn-primary" asp-action="Create">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Dodaj pacjenta
            </a>
        }
    </div>

    <form asp-action="Index" method="get" class="search-card">
        <div class="search-field">
            <label for="query" class="form-label">Wyszukaj pacjenta</label>
            <input id="query"
                   name="query"
                   value="@query"
                   class="form-control"
                   placeholder="Wpisz nazwisko lub PESEL" />
        </div>
        <div class="search-actions">
            <button type="submit" class="btn btn-primary">Szukaj</button>
            @if (isSearchActive)
            {
                <a class="btn btn-secondary" asp-action="Index">Wyczyść</a>
            }
        </div>
    </form>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            @successMessage
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
            </svg>
            <p>@(isSearchActive ? "Nie znaleziono pacjentów dla podanej frazy." : "Brak pacjentów w systemie.")</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Pacjent</th>
                        <th>PESEL</th>
                        <th>Numer ubezpieczenia</th>
                        <th>Data urodzenia</th>
                        <th class="th-action">Akcje</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var patient in Model)
                    {
                        <tr>
                            <td>
                                <a class="name-link" asp-action="Details" asp-route-id="@patient.PatientId">
                                    @patient.FirstName @patient.LastName
                                </a>
                            </td>
                            <td class="cell--muted">@patient.PESEL</td>
                            <td><span class="id-chip">@patient.InsuranceNumber</span></td>
                            <td class="cell--date">@patient.BirthDate.ToString("dd.MM.yyyy")</td>
                            <td class="td-action">
                                <div class="action-group">
                                    <a class="btn-mini btn-mini--secondary" asp-action="Details" asp-route-id="@patient.PatientId">Szczegóły</a>
                                    @if (canManagePatients)
                                    {
                                        <a class="btn-mini btn-mini--primary" asp-action="Edit" asp-route-id="@patient.PatientId">Edytuj</a>
                                        <a class="btn-mini btn-mini--danger" asp-action="Delete" asp-route-id="@patient.PatientId">Usuń</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; }
    .page-wrapper { max-width: 1080px; margin: 2.5rem auto; padding: 0 1rem; font-family: 'Inter', system-ui, -apple-system, sans-serif; color: #1E293B; }
    .page-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .page-header__left { display: flex; align-items: center; gap: 1rem; }
    .page-header__icon { width: 48px; height: 48px; background: #EFF6FF; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #2563EB; flex-shrink: 0; }
    .page-header__icon svg { width: 22px; height: 22px; }
    .page-header__title { font-size: 1.5rem; font-weight: 700; color: #0F172A; margin: 0 0 .15rem; letter-spacing: -.02em; }
    .page-header__sub { font-size: .82rem; color: #94A3B8; margin: 0; }
    .search-card { display: flex; align-items: end; gap: .85rem; background: #fff; border: 1px solid #E2E8F0; border-radius: 14px; padding: 1rem; margin-bottom: 1.25rem; box-shadow: 0 1px 3px rgba(0,0,0,.04); }
    .search-field { flex: 1 1 360px; display: flex; flex-direction: column; gap: .4rem; }
    .search-actions { display: flex; gap: .6rem; flex-wrap: wrap; }
    .form-label { font-size: .82rem; font-weight: 600; color: #374151; }
    .form-control { width: 100%; padding: .6rem .85rem; font-size: .9rem; color: #1E293B; background: #FAFAFA; border: 1.5px solid #D1D5DB; border-radius: 9px; transition: border-color .18s, box-shadow .18s; outline: none; }
    .form-control:focus { border-color: #3B82F6; background: #fff; box-shadow: 0 0 0 3px rgba(59,130,246,.15); }
    .alert { display: flex; align-items: center; gap: .65rem; padding: .8rem 1.1rem; border-radius: 10px; font-size: .875rem; margin-bottom: 1.25rem; }
    .alert-success { background: #F0FDF4; border: 1px solid #BBF7D0; color: #166534; }
    .empty-state { display: flex; flex-direction: column; align-items: center; gap: .75rem; padding: 3.5rem 2rem; background: #fff; border: 1px dashed #D1D5DB; border-radius: 14px; color: #94A3B8; text-align: center; }
    .empty-state svg { width: 42px; height: 42px; }
    .empty-state p { font-size: .9rem; margin: 0; }
    .table-card { background: #fff; border: 1px solid #E2E8F0; border-radius: 14px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.05); }
    .table-scroll { overflow-x: auto; }
    .data-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .data-table thead tr { background: #F8FAFC; }
    .data-table th { padding: .75rem 1.1rem; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #64748B; text-align: left; border-bottom: 1px solid #E2E8F0; white-space: nowrap; }
    .data-table td { padding: .85rem 1.1rem; border-bottom: 1px solid #F1F5F9; vertical-align: middle; white-space: nowrap; }
    .data-table tbody tr:last-child td { border-bottom: none; }
    .data-table tbody tr:hover { background: #FAFBFF; }
    .th-action, .td-action { text-align: right; }
    .name-link { color: #2563EB; font-weight: 600; text-decoration: none; }
    .name-link:hover { text-decoration: underline; }
    .id-chip { display: inline-block; font-size: .74rem; font-weight: 600; color: #64748B; background: #F1F5F9; border-radius: 6px; padding: .2rem .55rem; font-variant-numeric: tabular-nums; }
    .cell--date { font-variant-numeric: tabular-nums; color: #475569; }
    .cell--muted { color: #64748B; }
    .action-group { display: inline-flex; align-items: center; justify-content: flex-end; gap: .45rem; }
    .btn, .btn-mini { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; font-weight: 600; border: 1.5px solid transparent; cursor: pointer; text-decoration: none; transition: all .18s; font-family: inherit; white-space: nowrap; }
    .btn { padding: .6rem 1.3rem; font-size: .875rem; border-radius: 9px; }
    .btn-mini { padding: .4rem .8rem; font-size: .78rem; border-radius: 7px; }
    .btn-primary { background: #2563EB; color: #fff; border-color: #2563EB; }
    .btn-primary:hover { background: #1D4ED8; border-color: #1D4ED8; box-shadow: 0 4px 12px rgba(37,99,235,.3); transform: translateY(-1px); }
    .btn-secondary, .btn-mini--secondary { background: #fff; color: #475569; border-color: #D1D5DB; }
    .btn-secondary:hover, .btn-mini--secondary:hover { background: #F8FAFC; border-color: #94A3B8; }
    .btn-mini--primary { background: #EFF6FF; color: #2563EB; border-color: #BFDBFE; }
    .btn-mini--primary:hover { background: #2563EB; color: #fff; border-color: #2563EB; }
    .btn-mini--danger { background: #FEF2F2; color: #DC2626; border-color: #FECACA; }
    .btn-mini--danger:hover { background: #DC2626; color: #fff; border-color: #DC2626; }
    @@media (max-width: 700px) {
        .search-card { align-items: stretch; flex-direction: column; }
        .search-field { flex-basis: auto; width: 100%; }
        .data-table th, .data-table td { padding: .7rem .8rem; }
    }
</style>
