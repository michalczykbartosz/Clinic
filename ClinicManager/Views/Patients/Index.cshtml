@model IReadOnlyList<ClinicManager.DTOs.PatientDto>

@{
    ViewData["Title"] = "Pacjenci";
    var query = ViewData["Query"] as string ?? string.Empty;
    var isSearchActive = !string.IsNullOrWhiteSpace(query);
    var canManagePatients = User.IsInRole("Admin") || User.IsInRole("Rejestratorka");
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Pacjenci</h1>
    @if (canManagePatients)
    {
        <a class="btn btn-primary" asp-action="Create">Dodaj pacjenta</a>
    }
</div>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-8 col-lg-6">
        <label for="query" class="form-label">Wyszukaj pacjenta</label>
        <input id="query"
               name="query"
               value="@query"
               class="form-control"
               placeholder="Wpisz nazwisko lub PESEL" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Szukaj</button>
    </div>
    @if (isSearchActive)
    {
        <div class="col-auto">
            <a class="btn btn-outline-secondary" asp-action="Index">Wyczyść</a>
        </div>
    }
</form>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (Model.Count == 0)
{
    if (isSearchActive)
    {
        <div class="alert alert-info" role="alert">Nie znaleziono pacjentów dla podanej frazy.</div>
    }
    else
    {
        <div class="alert alert-info" role="alert">Brak pacjentów w systemie.</div>
    }
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Imię</th>
                    <th>Nazwisko</th>
                    <th>PESEL</th>
                    <th>Numer ubezpieczenia</th>
                    <th>Data urodzenia</th>
                    <th class="text-end">Akcje</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var patient in Model)
            {
                <tr>
                    <td>@patient.FirstName</td>
                    <td>@patient.LastName</td>
                    <td>@patient.PESEL</td>
                    <td>@patient.InsuranceNumber</td>
                    <td>@patient.BirthDate.ToString("dd.MM.yyyy")</td>
                    <td class="text-end">
                        <div class="btn-group" role="group" aria-label="Akcje pacjenta">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@patient.PatientId">Szczegóły</a>
                            @if (canManagePatients)
                            {
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@patient.PatientId">Edytuj</a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@patient.PatientId">Usuń</a>
                            }
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
