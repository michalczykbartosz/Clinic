@model ClinicManager.ViewModels.CreateVisitViewModel

@{
    ViewData["Title"] = "Dodaj wizytę";
}

<div class="visit-wrapper">

    <div class="page-header">
        <div class="page-header__left">
            <div class="page-header__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                    <line x1="12" y1="14" x2="12" y2="18"/>
                    <line x1="10" y1="16" x2="14" y2="16"/>
                </svg>
            </div>
            <div>
                <h1 class="page-header__title">Dodaj wizytę</h1>
                <p class="page-header__sub">Zaplanuj nową wizytę w systemie</p>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2.2"
                 stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"/>
            </svg>
            Powrót
        </a>
    </div>

    <div class="form-card">
        <form asp-action="Create" method="post">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-section">
                <h2 class="form-section__title">
                    <span class="form-section__number">01</span>
                    Uczestnicy wizyty
                </h2>

                <div class="form-grid">
                    <div class="form-group">
                        <label asp-for="Visit.PatientId" class="form-label">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                <circle cx="12" cy="7" r="4"/>
                            </svg>
                            Pacjent
                        </label>
                        <select asp-for="Visit.PatientId" asp-items="Model.Patients" class="form-control form-select">
                            <option value="0">Wybierz pacjenta</option>
                        </select>
                        <span asp-validation-for="Visit.PatientId" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Visit.DoctorId" class="form-label">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                                <polyline points="9 22 9 12 15 12 15 22"/>
                            </svg>
                            Lekarz
                        </label>
                        <select asp-for="Visit.DoctorId" asp-items="Model.Doctors" class="form-control form-select">
                            <option value="0">Wybierz lekarza</option>
                        </select>
                        <span asp-validation-for="Visit.DoctorId" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="form-section">
                <h2 class="form-section__title">
                    <span class="form-section__number">02</span>
                    Termin
                </h2>

                <div class="form-grid form-grid--single">
                    <div class="form-group">
                        <label asp-for="Visit.VisitDateTime" class="form-label">
                            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/>
                                <polyline points="12 6 12 12 16 14"/>
                            </svg>
                            Data i godzina wizyty
                        </label>
                        <input asp-for="Visit.VisitDateTime"
                               asp-format="{0:yyyy-MM-ddTHH:mm}"
                               class="form-control"
                               type="datetime-local" />
                        <span asp-validation-for="Visit.VisitDateTime" class="field-error"></span>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    Zapisz wizytę
                </button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; }

    .visit-wrapper {
        max-width: 720px;
        margin: 2.5rem auto;
        padding: 0 1rem;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #1E293B;
    }

    
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.75rem;
        flex-wrap: wrap;
    }

    .page-header__left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .page-header__icon {
        width: 48px;
        height: 48px;
        background: #EFF6FF;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2563EB;
        flex-shrink: 0;
    }

    .page-header__icon svg { width: 23px; height: 23px; }

    .page-header__title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #0F172A;
        margin: 0 0 .15rem;
        letter-spacing: -.02em;
    }

    .page-header__sub {
        font-size: .85rem;
        color: #64748B;
        margin: 0;
    }

    .form-card {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 16px;
        padding: 2rem 2.25rem;
        box-shadow: 0 1px 3px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.04);
    }

    .form-section { margin-bottom: 2rem; }
    .form-section:last-of-type { margin-bottom: 0; }

    .form-section__title {
        display: flex;
        align-items: center;
        gap: .65rem;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        color: #94A3B8;
        margin: 0 0 1.25rem;
    }

    .form-section__number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        background: #F1F5F9;
        border-radius: 6px;
        font-size: .72rem;
        color: #475569;
        font-weight: 700;
    }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
    }

    .form-grid--single { grid-template-columns: 1fr; }

    @@media (max-width: 520px) {
        .form-grid { grid-template-columns: 1fr; }
        .form-card { padding: 1.5rem 1.25rem; }
    }

    .form-group { display: flex; flex-direction: column; gap: .4rem; }

    .form-label {
        font-size: .82rem;
        font-weight: 600;
        color: #374151;
        display: flex;
        align-items: center;
        gap: .45rem;
    }

    .form-label svg { color: #94A3B8; flex-shrink: 0; }

    .form-control {
        width: 100%;
        padding: .6rem .85rem;
        font-size: .9rem;
        color: #1E293B;
        background: #FAFAFA;
        border: 1.5px solid #D1D5DB;
        border-radius: 9px;
        transition: border-color .18s, box-shadow .18s;
        outline: none;
    }

    .form-control:focus {
        border-color: #3B82F6;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(59,130,246,.15);
    }

    .form-select {
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2394A3B8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right .75rem center;
        background-size: 16px;
        padding-right: 2.25rem;
        cursor: pointer;
    }

    .field-error {
        font-size: .78rem;
        color: #DC2626;
        font-weight: 500;
    }

    
    .alert {
        padding: .85rem 1rem;
        border-radius: 9px;
        font-size: .875rem;
        margin-bottom: 1.5rem;
    }

    .alert-danger {
        background: #FEF2F2;
        border: 1px solid #FECACA;
        color: #991B1B;
    }

    .alert:empty { display: none; }

    
    .form-actions {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding-top: 1.5rem;
        border-top: 1px solid #F1F5F9;
        margin-top: 2rem;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .65rem 1.5rem;
        font-size: .875rem;
        font-weight: 600;
        border-radius: 9px;
        border: 1.5px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: all .18s;
        font-family: inherit;
    }

    .btn-primary {
        background: #2563EB;
        color: #fff;
        border-color: #2563EB;
    }

    .btn-primary:hover {
        background: #1D4ED8;
        border-color: #1D4ED8;
        box-shadow: 0 4px 12px rgba(37,99,235,.35);
        transform: translateY(-1px);
    }

    .btn-secondary {
        background: #fff;
        color: #475569;
        border-color: #D1D5DB;
    }

    .btn-secondary:hover {
        background: #F8FAFC;
        border-color: #94A3B8;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
