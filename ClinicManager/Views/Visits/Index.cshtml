@using ClinicManager.Models
@using System.Globalization
@model IReadOnlyList<ClinicManager.DTOs.VisitListItemDto>

@{
    ViewData["Title"] = "Wizyty";
    var canCreateVisit = User.IsInRole("Admin") || User.IsInRole("Rejestratorka");
    var canUpdateVisitStatus = User.IsInRole("Admin") || User.IsInRole("Rejestratorka") || User.IsInRole("Lekarz");
    var canManagePayments = User.IsInRole("Admin") || User.IsInRole("Rejestratorka");
    var canManageClinicalNotes = User.IsInRole("Lekarz");
    var query = ViewData["Query"] as string ?? string.Empty;
    var selectedStatus = ViewData["Status"] as VisitState?;
    var isPatientView = ViewData["IsPatientView"] as bool? == true;
    var patientAccessMessage = ViewData["PatientAccessMessage"] as string;
    var isSearchActive = selectedStatus.HasValue || (!isPatientView && !string.IsNullOrWhiteSpace(query));
}

@functions {
    private static IReadOnlyList<(VisitState Status, string Label)> GetVisitStatusOptions()
    {
        return
        [
            (VisitState.Planned, "Zaplanowana"),
            (VisitState.InProgress, "W trakcie"),
            (VisitState.Finished, "Zakończona"),
            (VisitState.Canceled, "Anulowana")
        ];
    }

    private static string GetVisitStatusLabel(VisitState status)
    {
        return status switch
        {
            VisitState.Planned => "Zaplanowana",
            VisitState.InProgress => "W trakcie",
            VisitState.Finished => "Zakończona",
            VisitState.Canceled => "Anulowana",
            _ => status.ToString()
        };
    }

    private static string GetVisitStatusBadgeClass(VisitState status)
    {
        return status switch
        {
            VisitState.Planned => "status-badge--planned",
            VisitState.InProgress => "status-badge--progress",
            VisitState.Finished => "status-badge--finished",
            VisitState.Canceled => "status-badge--canceled",
            _ => "status-badge--default"
        };
    }

    private static string FormatMoney(decimal amount)
    {
        return amount.ToString("C", CultureInfo.GetCultureInfo("pl-PL"));
    }

    private static string GetPaymentBadgeClass(bool isPaid)
    {
        return isPaid ? "payment-badge--paid" : "payment-badge--unpaid";
    }
}

<div class="page-wrapper">
    <div class="page-header">
        <div class="page-header__left">
            <div class="page-header__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
            </div>
            <div>
                <h1 class="page-header__title">Wizyty</h1>
                <p class="page-header__sub">@(isPatientView ? $"{Model.Count} Twoich wizyt" : $"{Model.Count} wizyt w systemie")</p>
            </div>
        </div>
        @if (canCreateVisit)
        {
            <a class="btn btn-primary" asp-action="Create">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"/>
                    <line x1="5" y1="12" x2="19" y2="12"/>
                </svg>
                Dodaj wizytę
            </a>
        }
    </div>

    <form asp-action="Index" method="get" class="search-card">
        @if (isPatientView)
        {
            <div class="search-field">
                <label class="form-label">Widok</label>
                <div class="patient-view-pill">Moje wizyty</div>
            </div>
        }
        else
        {
            <div class="search-field">
                <label for="query" class="form-label">Wyszukaj wizytę</label>
                <input id="query"
                       name="query"
                       value="@query"
                       class="form-control"
                       placeholder="Wpisz nazwisko pacjenta lub PESEL" />
            </div>
        }
        <div class="status-filter">
            <label for="status" class="form-label">Status</label>
            <select id="status" name="status" class="form-control form-select">
                <option value="">Wszystkie</option>
                @foreach (var option in GetVisitStatusOptions())
                {
                    if (selectedStatus == option.Status)
                    {
                        <option value="@option.Status" selected>@option.Label</option>
                    }
                    else
                    {
                        <option value="@option.Status">@option.Label</option>
                    }
                }
            </select>
        </div>
        <div class="search-actions">
            <button type="submit" class="btn btn-primary">Szukaj</button>
            @if (isSearchActive)
            {
                <a class="btn btn-secondary" asp-action="Index">Wyczyść</a>
            }
        </div>
    </form>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            @successMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            @errorMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(patientAccessMessage))
    {
        <div class="alert alert-danger">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            @patientAccessMessage
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <p>@(isSearchActive ? "Nie znaleziono wizyt dla podanej frazy." : "Brak wizyt w systemie.")</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <table class="data-table visits-table">
                <thead>
                    <tr>
                        <th>Numer</th>
                        <th>Data</th>
                        <th>Status</th>
                        <th>Pacjent</th>
                        <th>Lekarz</th>
                        <th>Rozliczenie</th>
                        @if (canUpdateVisitStatus)
                        {
                            <th class="th-action">Obsługa</th>
                        }
                    </tr>
                </thead>
                <tbody>
                @for (var index = 0; index < Model.Count; index++)
                {
                    var visit = Model[index];
                    <tr>
                        <td data-label="Numer"><span class="id-chip">#@(index + 1)</span></td>
                        <td data-label="Data" class="cell--date">@visit.VisitDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td data-label="Status">
                            <span class="status-badge @GetVisitStatusBadgeClass(visit.VisitStatus)">
                                @GetVisitStatusLabel(visit.VisitStatus)
                            </span>
                        </td>
                        <td data-label="Pacjent">
                            @if (isPatientView)
                            {
                                <span class="cell-main">@visit.PatientFullName</span>
                            }
                            else
                            {
                                <a asp-controller="Patients" asp-action="Details" asp-route-id="@visit.PatientId" class="name-link">
                                    @visit.PatientFullName
                                </a>
                                <span class="cell-note">PESEL: @visit.PatientPESEL</span>
                            }
                        </td>
                        <td data-label="Lekarz">
                            <span class="cell-main">@visit.DoctorFullName</span>
                            <span class="cell-note">@visit.DoctorSpecialization</span>
                        </td>
                        <td data-label="Rozliczenie">
                            <span class="cell-main">@FormatMoney(visit.Cost)</span>
                            @if (canManagePayments)
                            {
                                <form asp-action="UpdatePayment"
                                      asp-route-id="@visit.VisitId"
                                      method="post"
                                      class="payment-form">
                                    <input type="hidden" name="query" value="@query" />
                                    <input type="hidden" name="status" value="@selectedStatus" />
                                    <label class="payment-toggle">
                                        <input type="checkbox"
                                               name="isPaid"
                                               value="true"
                                               checked="@visit.IsPaid"
                                               onchange="this.form.submit()" />
                                        <span>@(visit.IsPaid ? "Opłacone" : "Nieopłacone")</span>
                                    </label>
                                    <input type="hidden" name="isPaid" value="false" />
                                </form>
                            }
                            else
                            {
                                <span class="payment-badge @GetPaymentBadgeClass(visit.IsPaid)">
                                    @(visit.IsPaid ? "Opłacone" : "Nieopłacone")
                                </span>
                            }
                        </td>
                        @if (canUpdateVisitStatus)
                        {
                            <td data-label="Obsługa" class="td-action">
                                <form asp-action="UpdateStatus"
                                      asp-route-id="@visit.VisitId"
                                      method="post"
                                      class="status-form">
                                    <input type="hidden" name="query" value="@query" />
                                    <input type="hidden" name="status" value="@selectedStatus" />
                                    <div class="status-form__top">
                                        <select name="VisitStatus"
                                                class="status-select"
                                                aria-label="Status wizyty @visit.VisitId">
                                            @foreach (var option in GetVisitStatusOptions())
                                            {
                                                if (option.Status == visit.VisitStatus)
                                                {
                                                    <option value="@option.Status" selected>@option.Label</option>
                                                }
                                                else
                                                {
                                                    <option value="@option.Status">@option.Label</option>
                                                }
                                            }
                                        </select>
                                        <button type="submit" class="btn-mini btn-mini--primary">Zapisz</button>
                                    </div>
                                    <div class="visit-actions">
                                        @if (canManageClinicalNotes)
                                        {
                                            <a class="btn-mini btn-mini--secondary"
                                               asp-controller="ClinicalNote"
                                               asp-action="GetNote"
                                               asp-route-visitId="@visit.VisitId">
                                                @(visit.HasClinicalNote ? "Edytuj notatkę" : "Dodaj notatkę")
                                            </a>
                                        }
                                        <a class="btn-mini btn-mini--secondary"
                                           asp-controller="VisitMedications"
                                           asp-action="Index"
                                           asp-route-visitId="@visit.VisitId">
                                            Leki
                                        </a>
                                    </div>
                                </form>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; }

    .page-wrapper {
        max-width: 1220px;
        margin: 2.5rem auto;
        padding: 0 1rem;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #1E293B;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .page-header__left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .page-header__icon {
        width: 48px;
        height: 48px;
        background: #EFF6FF;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2563EB;
        flex-shrink: 0;
    }

    .page-header__icon svg { width: 22px; height: 22px; }

    .page-header__title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #0F172A;
        margin: 0 0 .15rem;
        letter-spacing: -.02em;
    }

    .page-header__sub {
        font-size: .82rem;
        color: #94A3B8;
        margin: 0;
    }

    .search-card {
        display: flex;
        align-items: end;
        gap: .85rem;
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        padding: 1rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
    }

    .search-field {
        flex: 1 1 360px;
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }

    .status-filter {
        flex: 0 0 190px;
        display: flex;
        flex-direction: column;
        gap: .4rem;
    }

    .search-actions {
        display: flex;
        gap: .6rem;
        flex-wrap: wrap;
    }

    .patient-view-pill {
        display: flex;
        align-items: center;
        min-height: 42px;
        padding: .6rem .85rem;
        color: #1E293B;
        background: #F8FAFC;
        border: 1.5px solid #D1D5DB;
        border-radius: 9px;
        font-size: .9rem;
        font-weight: 600;
    }

    .form-label {
        font-size: .82rem;
        font-weight: 600;
        color: #374151;
    }

    .form-control {
        width: 100%;
        padding: .6rem .85rem;
        font-size: .9rem;
        color: #1E293B;
        background: #FAFAFA;
        border: 1.5px solid #D1D5DB;
        border-radius: 9px;
        transition: border-color .18s, box-shadow .18s;
        outline: none;
    }

    .form-control:focus {
        border-color: #3B82F6;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(59,130,246,.15);
    }

    .form-select {
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2394A3B8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right .75rem center;
        background-size: 16px;
        padding-right: 2.25rem;
        cursor: pointer;
    }

    .alert {
        display: flex;
        align-items: center;
        gap: .65rem;
        padding: .8rem 1.1rem;
        border-radius: 10px;
        font-size: .875rem;
        margin-bottom: 1.25rem;
    }

    .alert svg { flex-shrink: 0; }
    .alert-success { background: #F0FDF4; border: 1px solid #BBF7D0; color: #166534; }
    .alert-danger { background: #FEF2F2; border: 1px solid #FECACA; color: #991B1B; }

    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .75rem;
        padding: 3.5rem 2rem;
        background: #fff;
        border: 1px dashed #D1D5DB;
        border-radius: 14px;
        color: #94A3B8;
        text-align: center;
    }

    .empty-state svg { width: 42px; height: 42px; }
    .empty-state p { font-size: .9rem; margin: 0; }

    .table-card {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(0,0,0,.05);
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .82rem;
        table-layout: fixed;
    }

    .data-table thead tr { background: #F8FAFC; }

    .data-table th {
        padding: .72rem .8rem;
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #64748B;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
    }

    .visits-table th:nth-child(1) { width: 70px; }
    .visits-table th:nth-child(2) { width: 126px; }
    .visits-table th:nth-child(3) { width: 118px; }
    .visits-table th:nth-child(4) { width: 18%; }
    .visits-table th:nth-child(5) { width: 18%; }
    .visits-table th:nth-child(6) { width: 132px; }
    .visits-table th:nth-child(7) { width: 260px; }

    .th-action { text-align: right; }

    .data-table td {
        padding: .8rem .8rem;
        border-bottom: 1px solid #F1F5F9;
        vertical-align: middle;
        white-space: normal;
    }

    .data-table tbody tr:last-child td { border-bottom: none; }
    .data-table tbody tr:hover { background: #FAFBFF; }

    .id-chip {
        display: inline-block;
        font-size: .74rem;
        font-weight: 600;
        color: #64748B;
        background: #F1F5F9;
        border-radius: 6px;
        padding: .2rem .55rem;
        font-variant-numeric: tabular-nums;
    }

    .cell--date {
        font-variant-numeric: tabular-nums;
        color: #475569;
    }

    .cell-main,
    .cell-note {
        display: block;
        overflow-wrap: anywhere;
        line-height: 1.35;
    }

    .cell-main { color: #1E293B; font-weight: 500; }

    .cell-note {
        color: #94A3B8;
        font-size: .76rem;
        margin-top: .15rem;
    }

    .name-link {
        color: #2563EB;
        display: inline-block;
        font-weight: 600;
        overflow-wrap: anywhere;
        text-decoration: none;
    }

    .name-link:hover { text-decoration: underline; }

    .status-badge {
        display: inline-block;
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        border-radius: 20px;
        padding: .25rem .62rem;
        white-space: nowrap;
    }

    .status-badge--planned   { background: #DBEAFE; color: #1D4ED8; }
    .status-badge--progress  { background: #FEF3C7; color: #92400E; }
    .status-badge--finished  { background: #D1FAE5; color: #065F46; }
    .status-badge--canceled  { background: #F1F5F9; color: #64748B; }
    .status-badge--default   { background: #F1F5F9; color: #64748B; }

    .payment-badge {
        display: inline-block;
        margin-top: .24rem;
        font-size: .68rem;
        font-weight: 700;
        border-radius: 20px;
        padding: .2rem .55rem;
        white-space: nowrap;
    }

    .payment-badge--paid {
        background: #D1FAE5;
        color: #065F46;
    }

    .payment-badge--unpaid {
        background: #FEF3C7;
        color: #92400E;
    }

    .payment-form {
        margin-top: .3rem;
    }

    .payment-toggle {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        font-size: .74rem;
        font-weight: 700;
        color: #475569;
        cursor: pointer;
        white-space: nowrap;
    }

    .payment-toggle input {
        width: 16px;
        height: 16px;
        margin: 0;
        accent-color: #16A34A;
        cursor: pointer;
    }

    .payment-toggle:has(input:checked) {
        color: #065F46;
    }

    .td-action { text-align: right; }

    .status-form {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: .5rem;
        width: 100%;
    }

    .status-form__top {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 68px;
        gap: .45rem;
    }

    .visit-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: .45rem;
    }

    .visit-actions .btn-mini:only-child {
        grid-column: 1 / -1;
    }

    .status-select {
        width: 100%;
        min-width: 0;
        font-size: .78rem;
        padding: .38rem .55rem;
        border: 1.5px solid #D1D5DB;
        border-radius: 7px;
        background: #FAFAFA;
        color: #1E293B;
        outline: none;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2394A3B8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right .5rem center;
        background-size: 14px;
        padding-right: 1.65rem;
        transition: border-color .15s;
    }

    .status-select:focus {
        border-color: #3B82F6;
        background-color: #fff;
    }

    .btn-mini {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        padding: .38rem .68rem;
        font-size: .76rem;
        font-weight: 600;
        border-radius: 7px;
        border: 1.5px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: all .15s;
        font-family: inherit;
        white-space: nowrap;
    }

    .btn-mini--primary {
        background: #EFF6FF;
        color: #2563EB;
        border-color: #BFDBFE;
    }

    .btn-mini--primary:hover {
        background: #2563EB;
        color: #fff;
        border-color: #2563EB;
    }

    .btn-mini--secondary {
        background: #fff;
        color: #475569;
        border-color: #D1D5DB;
    }

    .btn-mini--secondary:hover {
        background: #F8FAFC;
        border-color: #94A3B8;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        padding: .6rem 1.3rem;
        font-size: .875rem;
        font-weight: 600;
        border-radius: 9px;
        border: 1.5px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: all .18s;
        font-family: inherit;
    }

    .btn-primary {
        background: #2563EB;
        color: #fff;
        border-color: #2563EB;
    }

    .btn-primary:hover {
        background: #1D4ED8;
        border-color: #1D4ED8;
        box-shadow: 0 4px 12px rgba(37,99,235,.3);
        transform: translateY(-1px);
    }

    .btn-secondary {
        background: #fff;
        color: #475569;
        border-color: #D1D5DB;
    }

