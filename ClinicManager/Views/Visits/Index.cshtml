@using ClinicManager.Models
@model IReadOnlyList<ClinicManager.DTOs.VisitListItemDto>

@{
    ViewData["Title"] = "Wizyty";
    var canCreateVisit = User.IsInRole("Admin") || User.IsInRole("Rejestratorka");
    var canUpdateVisitStatus = User.IsInRole("Admin") || User.IsInRole("Rejestratorka") || User.IsInRole("Lekarz");
    var canManageClinicalNotes = User.IsInRole("Lekarz");
}

@functions {
    private static IReadOnlyList<(VisitState Status, string Label)> GetVisitStatusOptions()
    {
        return
        [
            (VisitState.Planned, "Zaplanowana"),
            (VisitState.InProgress, "W trakcie"),
            (VisitState.Finished, "Zakończona"),
            (VisitState.Canceled, "Anulowana")
        ];
    }

    private static string GetVisitStatusLabel(VisitState status)
    {
        return status switch
        {
            VisitState.Planned => "Zaplanowana",
            VisitState.InProgress => "W trakcie",
            VisitState.Finished => "Zakończona",
            VisitState.Canceled => "Anulowana",
            _ => status.ToString()
        };
    }

    private static string GetVisitStatusBadgeClass(VisitState status)
    {
        return status switch
        {
            VisitState.Planned => "bg-primary",
            VisitState.InProgress => "bg-warning text-dark",
            VisitState.Finished => "bg-success",
            VisitState.Canceled => "bg-secondary",
            _ => "bg-light text-dark"
        };
    }
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h3 mb-0">Wizyty</h1>
    @if (canCreateVisit)
    {
        <a class="btn btn-primary" asp-action="Create">Dodaj wizytę</a>
    }
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info" role="alert">Brak wizyt w systemie.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Numer wizyty</th>
                    <th>Data i godzina</th>
                    <th>Status</th>
                    <th>Pacjent</th>
                    <th>PESEL</th>
                    <th>Lekarz</th>
                    <th>Specjalizacja</th>
                    @if (canUpdateVisitStatus)
                    {
                        <th class="text-end">Zmień status</th>
                    }
                </tr>
            </thead>
            <tbody>
            @foreach (var visit in Model)
            {
                <tr>
                    <td>@visit.VisitId</td>
                    <td>@visit.VisitDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        <span class="badge @GetVisitStatusBadgeClass(visit.VisitStatus)">
                            @GetVisitStatusLabel(visit.VisitStatus)
                        </span>
                    </td>
                    <td>
                        <a asp-controller="Patients" asp-action="Details" asp-route-id="@visit.PatientId">
                            @visit.PatientFullName
                        </a>
                    </td>
                    <td>@visit.PatientPESEL</td>
                    <td>@visit.DoctorFullName</td>
                    <td>@visit.DoctorSpecialization</td>
                    @if (canUpdateVisitStatus)
                    {
                        <td>
                            <form asp-action="UpdateStatus"
                                  asp-route-id="@visit.VisitId"
                                  method="post"
                                  class="d-flex justify-content-end gap-2">
                                <select name="VisitStatus"
                                        class="form-select form-select-sm w-auto"
                                        aria-label="Status wizyty @visit.VisitId">
                                    @foreach (var option in GetVisitStatusOptions())
                                    {
                                        if (option.Status == visit.VisitStatus)
                                        {
                                            <option value="@option.Status" selected>@option.Label</option>
                                        }
                                        else
                                        {
                                            <option value="@option.Status">@option.Label</option>
                                        }
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm btn-outline-primary">Zapisz</button>
                                @if (canManageClinicalNotes)
                                {
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-controller="ClinicalNote"
                                       asp-action="GetNote"
                                       asp-route-visitId="@visit.VisitId">
                                        @(visit.HasClinicalNote ? "Edytuj notatkę kliniczną" : "Dodaj notatkę kliniczną")
                                    </a>
                                }
                            </form>
                        </td>
                    }
                </tr>
            }
            </tbody>
        </table>
    </div>
}
