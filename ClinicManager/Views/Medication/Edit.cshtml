@model ClinicManager.DTOs.MedicationDto

@{
    ViewData["Title"] = "Edytuj lek";
}

<div class="form-wrapper">
    <div class="page-header">
        <div class="page-header__left">
            <div class="page-header__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10.5 20.5l10-10a4.24 4.24 0 0 0-6-6l-10 10a4.24 4.24 0 0 0 6 6z"/>
                    <path d="M8.5 8.5l7 7"/>
                    <path d="M17 3l4 4"/>
                </svg>
            </div>
            <div>
                <h1 class="page-header__title">Edytuj lek</h1>
                <p class="page-header__sub">Zaktualizuj dane leku w katalogu</p>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-secondary">Powrót</a>
    </div>

    <div class="form-card">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="MedicationId" />
            <partial name="_MedicationForm" model="Model" />

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Zapisz zmiany</button>
                <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
            </div>
        </form>
    </div>
</div>

<partial name="_MedicationFormStyles" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
