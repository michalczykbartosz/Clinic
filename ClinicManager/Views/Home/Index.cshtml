@{
    ViewData["Title"] = "Panel główny";
}

<div class="home-wrapper">
    <section class="home-hero">
        <div class="home-hero__content">
            <div class="home-hero__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 21h18"/>
                    <path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"/>
                    <path d="M9 21v-6h6v6"/>
                    <path d="M10 8h4"/>
                    <path d="M12 6v4"/>
                </svg>
            </div>
            <div>
                <h1>ClinicManager</h1>
                <p>Centralne miejsce do obsługi pacjentów, wizyt, leków, kont i raportów w placówce medycznej.</p>
            </div>
        </div>
        <div class="home-hero__actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn btn-primary" asp-controller="Visits" asp-action="Index">Przejdź do wizyt</a>
                <a class="btn btn-secondary" asp-controller="Patients" asp-action="Index">Pacjenci</a>
            }
            else
            {
                <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Zaloguj</a>
                <a class="btn btn-secondary" asp-controller="Account" asp-action="Register">Zarejestruj</a>
            }
        </div>
    </section>

    <section class="quick-grid" aria-label="Najważniejsze obszary systemu">
        @if (User.IsInRole("Admin") || User.IsInRole("Rejestratorka") || User.IsInRole("Lekarz"))
        {
            <a class="quick-tile" asp-controller="Patients" asp-action="Index">
                <span class="quick-tile__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </span>
                <strong>Pacjenci</strong>
                <span>Kartoteka, dane identyfikacyjne i historia wizyt.</span>
            </a>

            <a class="quick-tile" asp-controller="Visits" asp-action="Index">
                <span class="quick-tile__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="18" rx="2"/>
                        <line x1="16" y1="2" x2="16" y2="6"/>
                        <line x1="8" y1="2" x2="8" y2="6"/>
                        <line x1="3" y1="10" x2="21" y2="10"/>
                    </svg>
                </span>
                <strong>Wizyty</strong>
                <span>Terminy, statusy i notatki kliniczne.</span>
            </a>
        }

        @if (User.IsInRole("Admin") || User.IsInRole("Rejestratorka"))
        {
            <a class="quick-tile" asp-controller="Medication" asp-action="Index">
                <span class="quick-tile__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.5 20.5l10-10a4.24 4.24 0 0 0-6-6l-10 10a4.24 4.24 0 0 0 6 6z"/>
                        <path d="M8.5 8.5l7 7"/>
                    </svg>
                </span>
                <strong>Leki</strong>
                <span>Katalog leków, dawek i producentów.</span>
            </a>

            <a class="quick-tile" asp-controller="AdminUsers" asp-action="GetRoles">
                <span class="quick-tile__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </span>
                <strong>Konta</strong>
                <span>Role użytkowników i dostęp do funkcji systemu.</span>
            </a>
        }

        @if (User.IsInRole("Admin"))
        {
            <a class="quick-tile" asp-controller="Report" asp-action="Index">
                <span class="quick-tile__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                        <polyline points="14 2 14 8 20 8"/>
                        <line x1="16" y1="13" x2="8" y2="13"/>
                        <line x1="16" y1="17" x2="8" y2="17"/>
                    </svg>
                </span>
                <strong>Raporty</strong>
                <span>Zestawienia kosztów według zakresu i kryteriów.</span>
            </a>
        }

        <a class="quick-tile" asp-controller="Home" asp-action="Privacy">
            <span class="quick-tile__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <path d="M9 12l2 2 4-4"/>
                </svg>
            </span>
            <strong>RODO</strong>
            <span>Zasady ochrony danych medycznych i prywatności.</span>
        </a>
    </section>

    <section class="info-band">
        <div>
            <h2>Bezpieczna praca z dokumentacją</h2>
            <p>System porządkuje codzienne czynności placówki i wspiera ograniczanie dostępu do danych zgodnie z rolą użytkownika.</p>
        </div>
        <a class="btn btn-secondary" asp-controller="Home" asp-action="Privacy">Zobacz zasady prywatności</a>
    </section>
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; }

    .home-wrapper {
        max-width: 1120px;
        margin: 2.5rem auto;
        padding: 0 1rem;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #1E293B;
    }

    .home-hero {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 1px 3px rgba(0,0,0,.06), 0 4px 16px rgba(0,0,0,.04);
        margin-bottom: 1.25rem;
    }

    .home-hero__content {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        min-width: 0;
    }

    .home-hero__icon,
    .quick-tile__icon {
        background: #EFF6FF;
        color: #2563EB;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .home-hero__icon {
        width: 58px;
        height: 58px;
        border-radius: 14px;
    }

    .home-hero__icon svg { width: 29px; height: 29px; }
    .home-hero h1 { color: #0F172A; font-size: 1.75rem; font-weight: 750; margin: 0 0 .35rem; letter-spacing: -.02em; }
    .home-hero p { color: #64748B; font-size: .95rem; line-height: 1.6; margin: 0; max-width: 620px; }
    .home-hero__actions { display: flex; align-items: center; gap: .65rem; flex-wrap: wrap; flex-shrink: 0; }

    .quick-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: .9rem;
        margin-bottom: 1.25rem;
    }

    .quick-tile {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        color: #1E293B;
        display: flex;
        flex-direction: column;
        gap: .55rem;
        min-height: 170px;
        padding: 1.1rem;
        text-decoration: none;
        transition: border-color .18s, box-shadow .18s, transform .18s;
    }

    .quick-tile:hover {
        border-color: #BFDBFE;
        box-shadow: 0 8px 22px rgba(37,99,235,.12);
        color: #1E293B;
        transform: translateY(-2px);
    }

    .quick-tile:hover strong { color: #0F172A; }
    .quick-tile:hover span:last-child { color: #64748B; }

    .quick-tile__icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
    }

    .quick-tile__icon svg { width: 20px; height: 20px; }
    .quick-tile strong { color: #0F172A; font-size: 1rem; }
    .quick-tile span:last-child { color: #64748B; font-size: .84rem; line-height: 1.5; }

    .info-band {
        align-items: center;
        background: #F8FAFC;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        display: flex;
        gap: 1rem;
        justify-content: space-between;
        padding: 1.25rem 1.5rem;
    }

    .info-band h2 { color: #0F172A; font-size: 1rem; font-weight: 700; margin: 0 0 .25rem; }
    .info-band p { color: #64748B; font-size: .86rem; line-height: 1.55; margin: 0; }

    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        padding: .65rem 1.35rem;
        font-size: .875rem;
        font-weight: 600;
        border-radius: 9px;
        border: 1.5px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: all .18s;
        font-family: inherit;
        white-space: nowrap;
    }

    .btn-primary { background: #2563EB; color: #fff !important; border-color: #2563EB; }
    .btn-primary:hover { background: #1D4ED8; border-color: #1D4ED8; color: #fff !important; box-shadow: 0 4px 12px rgba(37,99,235,.3); transform: translateY(-1px); }
    .btn-secondary { background: #fff; color: #475569 !important; border-color: #D1D5DB; }
    .btn-secondary:hover { background: #F8FAFC; border-color: #94A3B8; color: #1E293B !important; }

    @@media (max-width: 760px) {
        .home-hero,
        .home-hero__content,
        .info-band {
            align-items: stretch;
            flex-direction: column;
        }

        .home-hero__actions .btn,
        .info-band .btn {
            width: 100%;
        }
    }
</style>
