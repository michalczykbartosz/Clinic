@model ClinicManager.ViewModels.CreateVisitMedicationViewModel

@{
    ViewData["Title"] = "Dodaj lek do wizyty";
}

<div class="page-wrapper">
    <div class="page-header">
        <div class="page-header__left">
            <div class="page-header__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 21h4"/>
                    <path d="M12 17v4"/>
                    <path d="M8 3h8l1 6a5 5 0 0 1-10 0l1-6Z"/>
                    <path d="M9 8h6"/>
                </svg>
            </div>
            <div>
                <h1 class="page-header__title">Dodaj lek do wizyty</h1>
                <p class="page-header__sub">Wybierz lek z katalogu, wpisz dawkowanie i ilość.</p>
            </div>
        </div>
        <a class="btn btn-secondary" asp-action="Index" asp-route-visitId="@Model.Medication.VisitId">
            Powrót
        </a>
    </div>

    @if (Model.AvailableMedications.Count == 0)
    {
        <div class="empty-state">
            <p>Brak leków w katalogu. Najpierw dodaj lek w module katalogu leków.</p>
        </div>
    }
    else
    {
        <form asp-action="Create" method="post" class="form-card">
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
            <input type="hidden" asp-for="Medication.VisitId" />

            <div class="form-group">
                <label asp-for="Medication.MedicationId"></label>
                <select asp-for="Medication.MedicationId"
                        asp-items="Model.AvailableMedications"
                        class="form-select">
                    <option value="0">Wybierz lek</option>
                </select>
                <span asp-validation-for="Medication.MedicationId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Medication.Dosage"></label>
                <textarea asp-for="Medication.Dosage"
                          class="form-control"
                          rows="5"
                          placeholder="Np. 1 tabletka rano po posiłku przez 7 dni"></textarea>
                <span asp-validation-for="Medication.Dosage" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Medication.Quantity"></label>
                <input asp-for="Medication.Quantity" class="form-control" type="number" min="1" />
                <span asp-validation-for="Medication.Quantity" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Zapisz lek</button>
                <a class="btn btn-secondary" asp-action="Index" asp-route-visitId="@Model.Medication.VisitId">
                    Anuluj
                </a>
            </div>
        </form>
    }
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; }
    .page-wrapper { max-width: 820px; margin: 2.5rem auto; padding: 0 1rem; font-family: 'Inter', system-ui, -apple-system, sans-serif; color: #1E293B; }
    .page-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .page-header__left { display: flex; align-items: center; gap: 1rem; }
    .page-header__icon { width: 48px; height: 48px; background: #EFF6FF; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #2563EB; flex-shrink: 0; }
    .page-header__icon svg { width: 22px; height: 22px; }
    .page-header__title { font-size: 1.5rem; font-weight: 700; color: #0F172A; margin: 0 0 .15rem; letter-spacing: -.02em; }
    .page-header__sub { font-size: .82rem; color: #94A3B8; margin: 0; }
    .form-card { background: #fff; border: 1px solid #E2E8F0; border-radius: 14px; box-shadow: 0 1px 3px rgba(0,0,0,.05); padding: 1.25rem; }
    .form-group { margin-bottom: 1rem; }
    .form-group label { display: block; font-size: .78rem; font-weight: 700; color: #334155; margin-bottom: .4rem; }
    .form-control, .form-select { width: 100%; border: 1.5px solid #D1D5DB; border-radius: 9px; padding: .65rem .75rem; font: inherit; color: #1E293B; background: #FAFAFA; transition: border-color .15s, box-shadow .15s, background .15s; }
    .form-control:focus, .form-select:focus { outline: none; border-color: #3B82F6; background: #fff; box-shadow: 0 0 0 3px rgba(59,130,246,.12); }
    textarea.form-control { resize: vertical; min-height: 130px; }
    .text-danger { display: block; color: #DC2626; font-size: .78rem; margin-top: .35rem; }
    .validation-summary { margin-bottom: .8rem; }
    .form-actions { display: flex; justify-content: flex-end; gap: .6rem; margin-top: 1.25rem; flex-wrap: wrap; }
    .empty-state { padding: 2.5rem 2rem; background: #fff; border: 1px dashed #D1D5DB; border-radius: 14px; color: #94A3B8; text-align: center; }
    .empty-state p { margin: 0; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; padding: .6rem 1.3rem; font-size: .875rem; font-weight: 600; border-radius: 9px; border: 1.5px solid transparent; cursor: pointer; text-decoration: none; transition: all .18s; font-family: inherit; white-space: nowrap; }
    .btn-primary { background: #2563EB; color: #fff; border-color: #2563EB; }
    .btn-primary:hover { background: #1D4ED8; border-color: #1D4ED8; box-shadow: 0 4px 12px rgba(37,99,235,.3); transform: translateY(-1px); }
    .btn-secondary { background: #fff; color: #475569; border-color: #D1D5DB; }
    .btn-secondary:hover { background: #F8FAFC; border-color: #94A3B8; }
    @@media (max-width: 560px) {
        .page-header > .btn { width: 100%; }
        .form-actions .btn { flex: 1; }
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
