@model ClinicManager.ViewModels.VisitMedicationsViewModel

@{
    ViewData["Title"] = "Leki wizyty";
    var canAddMedication = User.IsInRole("Lekarz");
}

<div class="page-wrapper">
    <div class="page-header">
        <div class="page-header__left">
            <div class="page-header__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 21h4"/>
                    <path d="M12 17v4"/>
                    <path d="M8 3h8l1 6a5 5 0 0 1-10 0l1-6Z"/>
                    <path d="M9 8h6"/>
                </svg>
            </div>
            <div>
                <h1 class="page-header__title">Leki wizyty</h1>
                <p class="page-header__sub">
                    @Model.PatientFullName, wizyta @Model.VisitDateTime.ToString("dd.MM.yyyy HH:mm")
                </p>
            </div>
        </div>
        <div class="header-actions">
            <a class="btn btn-secondary"
               asp-controller="Patients"
               asp-action="Details"
               asp-route-id="@Model.PatientId">
                Powrót
            </a>
            @if (canAddMedication)
            {
                <a class="btn btn-primary" asp-action="Create" asp-route-visitId="@Model.VisitId">
                    Dodaj lek
                </a>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    <div class="visit-summary">
        <div>
            <span>Pacjent</span>
            <strong>@Model.PatientFullName</strong>
        </div>
        <div>
            <span>Lekarz</span>
            <strong>@Model.DoctorFullName</strong>
        </div>
        <div>
            <span>Data wizyty</span>
            <strong>@Model.VisitDateTime.ToString("dd.MM.yyyy HH:mm")</strong>
        </div>
    </div>

    @if (Model.Medications.Count == 0)
    {
        <div class="empty-state">
            <p>Do tej wizyty nie przypisano jeszcze żadnych leków.</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                    <tr>
                        <th>Lek</th>
                        <th>Producent</th>
                        <th>Dawka</th>
                        <th>Dawkowanie</th>
                        <th class="th-action">Ilość</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var medication in Model.Medications)
                    {
                        <tr>
                            <td>
                                <span class="cell-main">@medication.MedicationName</span>
                            </td>
                            <td class="cell--muted">@medication.Manufacturer</td>
                            <td>@medication.Dose</td>
                            <td class="cell--wrap">@medication.Dosage</td>
                            <td class="td-action"><span class="id-chip">@medication.Quantity</span></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; }
    .page-wrapper { max-width: 1080px; margin: 2.5rem auto; padding: 0 1rem; font-family: 'Inter', system-ui, -apple-system, sans-serif; color: #1E293B; }
    .page-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
    .page-header__left, .header-actions { display: flex; align-items: center; gap: 1rem; }
    .header-actions { gap: .6rem; }
    .page-header__icon { width: 48px; height: 48px; background: #EFF6FF; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #2563EB; flex-shrink: 0; }
    .page-header__icon svg { width: 22px; height: 22px; }
    .page-header__title { font-size: 1.5rem; font-weight: 700; color: #0F172A; margin: 0 0 .15rem; letter-spacing: -.02em; }
    .page-header__sub { font-size: .82rem; color: #94A3B8; margin: 0; }
    .alert { padding: .8rem 1.1rem; border-radius: 10px; font-size: .875rem; margin-bottom: 1.25rem; }
    .alert-success { background: #F0FDF4; border: 1px solid #BBF7D0; color: #166534; }
    .visit-summary, .table-card { background: #fff; border: 1px solid #E2E8F0; border-radius: 14px; box-shadow: 0 1px 3px rgba(0,0,0,.05); }
    .visit-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; padding: 1rem; margin-bottom: 1.25rem; }
    .visit-summary div { background: #F8FAFC; border: 1px solid #EEF2F7; border-radius: 10px; padding: .85rem; }
    .visit-summary span { display: block; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #94A3B8; margin-bottom: .35rem; }
    .visit-summary strong { color: #0F172A; font-size: .9rem; }
    .empty-state { padding: 2.5rem 2rem; background: #fff; border: 1px dashed #D1D5DB; border-radius: 14px; color: #94A3B8; text-align: center; }
    .empty-state p { margin: 0; }
    .table-card { overflow: hidden; }
    .table-scroll { overflow-x: auto; }
    .data-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .data-table thead tr { background: #F8FAFC; }
    .data-table th { padding: .75rem 1.1rem; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #64748B; text-align: left; border-bottom: 1px solid #E2E8F0; white-space: nowrap; }
    .data-table td { padding: .85rem 1.1rem; border-bottom: 1px solid #F1F5F9; vertical-align: middle; }
    .data-table tbody tr:last-child td { border-bottom: none; }
    .data-table tbody tr:hover { background: #FAFBFF; }
    .th-action, .td-action { text-align: right; }
    .cell-main { color: #1E293B; font-weight: 600; }
    .cell--muted { color: #64748B; }
    .cell--wrap { white-space: normal; min-width: 240px; }
    .id-chip { display: inline-block; font-size: .74rem; font-weight: 600; color: #64748B; background: #F1F5F9; border-radius: 6px; padding: .2rem .55rem; font-variant-numeric: tabular-nums; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; padding: .6rem 1.3rem; font-size: .875rem; font-weight: 600; border-radius: 9px; border: 1.5px solid transparent; cursor: pointer; text-decoration: none; transition: all .18s; font-family: inherit; white-space: nowrap; }
    .btn-primary { background: #2563EB; color: #fff; border-color: #2563EB; }
    .btn-primary:hover { background: #1D4ED8; border-color: #1D4ED8; box-shadow: 0 4px 12px rgba(37,99,235,.3); transform: translateY(-1px); }
    .btn-secondary { background: #fff; color: #475569; border-color: #D1D5DB; }
    .btn-secondary:hover { background: #F8FAFC; border-color: #94A3B8; }
    @@media (max-width: 760px) {
        .visit-summary { grid-template-columns: 1fr; }
        .header-actions { width: 100%; }
        .header-actions .btn { flex: 1; }
    }
</style>
