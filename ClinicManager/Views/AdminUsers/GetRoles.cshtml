@model List<ClinicManager.DTOs.UserRolesDto>

@{
    ViewData["Title"] = "Użytkownicy i role";
    var roleFilter = (ViewData["RoleFilter"] as string) ?? "all";
    var totalUsersCount = ViewData["TotalUsersCount"] as int? ?? Model.Count;
}

<div class="page-wrapper">

    <div class="page-header">
        <div class="page-header__left">
            <div class="page-header__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <div>
                <h1 class="page-header__title">Użytkownicy i role</h1>
                <p class="page-header__sub">@Model.Count z @totalUsersCount użytkowników w systemie</p>
            </div>
        </div>

        <form asp-action="GetRoles" method="get" class="filter-form">
            <label for="roleFilter" class="filter-form__label">Filtr roli</label>
            <select id="roleFilter" name="roleFilter" class="filter-form__select" onchange="this.form.submit()">
                <option value="all" selected="@(roleFilter == "all")">Wszyscy użytkownicy</option>
                <option value="Admin" selected="@(roleFilter == "Admin")">Tylko admini</option>
                <option value="Lekarz" selected="@(roleFilter == "Lekarz")">Tylko lekarze</option>
                <option value="Rejestratorka" selected="@(roleFilter == "Rejestratorka")">Tylko rejestratorki</option>
                <option value="Pacjent" selected="@(roleFilter == "Pacjent")">Tylko pacjenci</option>
                <option value="none" selected="@(roleFilter == "none")">Bez roli</option>
            </select>
        </form>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">@successMessage</div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (!Model.Any())
    {
        <div class="empty-state">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
            </svg>
            <p>Brak użytkowników w systemie.</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Użytkownik</th>
                            <th>ID</th>
                            <th>Role</th>
                            <th class="th-action">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <div class="user-cell__avatar">@(string.IsNullOrWhiteSpace(user.Email) ? "?" : user.Email[0].ToString().ToUpper())</div>
                                        <span class="user-cell__email">@user.Email</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="id-chip">#@user.Id</span>
                                </td>
                                <td>
                                    <div class="roles-cell">
                                        @if (user.Roles.Any())
                                        {
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="role-badge role-badge--@role.ToLower()">@role</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="role-badge role-badge--none">Brak ról</span>
                                        }
                                    </div>
                                </td>
                                <td class="td-action">
                                    <div class="action-group">
                                        <a asp-action="EditRoles" asp-route-id="@user.Id" class="btn-edit">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                            Edytuj role
                                        </a>

                                        <form asp-action="Delete" asp-route-id="@user.Id" method="post"
                                              onsubmit="return confirm('Czy na pewno chcesz usunąć konto @user.Email?');">
                                            <button type="submit" class="btn-delete">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                                    <path d="M3 6h18"/>
                                                    <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                                    <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                                                    <path d="M10 11v6"/>
                                                    <path d="M14 11v6"/>
                                                </svg>
                                                Usuń konto
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; }

    .page-wrapper {
        max-width: 860px;
        margin: 2.5rem auto;
        padding: 0 1rem;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }

    /* ── Header ── */
    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.75rem;
    }

    .page-header__left {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .page-header__icon {
        width: 48px;
        height: 48px;
        background: #EFF6FF;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2563EB;
        flex-shrink: 0;
    }

    .page-header__icon svg { width: 22px; height: 22px; }

    .page-header__title {
        font-size: 1.5rem;
        font-weight: 700;
        color: #0F172A;
        margin: 0 0 .15rem;
        letter-spacing: -.02em;
    }

    .page-header__sub {
        font-size: .82rem;
        color: #94A3B8;
        margin: 0;
    }

    .filter-form {
        display: flex;
        align-items: center;
        gap: .55rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .filter-form__label {
        margin: 0;
        font-size: .76rem;
        font-weight: 700;
        color: #64748B;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .filter-form__select {
        min-width: 210px;
        height: 38px;
        border: 1.5px solid #D1D5DB;
        border-radius: 8px;
        background: #fff;
        color: #1E293B;
        font-size: .84rem;
        font-weight: 600;
        padding: 0 2rem 0 .8rem;
        outline: none;
    }

    .filter-form__select:focus {
        border-color: #3B82F6;
        box-shadow: 0 0 0 3px rgba(59,130,246,.15);
    }

    .alert {
        margin-bottom: 1rem;
        border-radius: 8px;
        padding: .75rem 1rem;
        font-size: .85rem;
        font-weight: 600;
    }

    .alert-success {
        color: #166534;
        background: #DCFCE7;
        border: 1px solid #BBF7D0;
    }

    .alert-danger {
        color: #991B1B;
        background: #FEE2E2;
        border: 1px solid #FECACA;
    }

    /* ── Table card ── */
    .table-card {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(0,0,0,.05);
    }

    .table-scroll { overflow-x: auto; }

    .data-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .875rem;
    }

    .data-table thead tr { background: #F8FAFC; }

    .data-table th {
        padding: .75rem 1.25rem;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .07em;
        color: #64748B;
        text-align: left;
        border-bottom: 1px solid #E2E8F0;
        white-space: nowrap;
    }

    .th-action { text-align: right; }

    .data-table td {
        padding: .9rem 1.25rem;
        border-bottom: 1px solid #F1F5F9;
        vertical-align: middle;
    }

    .data-table tbody tr:last-child td { border-bottom: none; }

    .data-table tbody tr {
        transition: background .12s;
    }

    .data-table tbody tr:hover { background: #FAFBFF; }

    /* ── User cell ── */
    .user-cell {
        display: flex;
        align-items: center;
        gap: .75rem;
    }

    .user-cell__avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: linear-gradient(135deg, #3B82F6, #6366F1);
        color: #fff;
        font-size: .8rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .user-cell__email {
        font-weight: 500;
        color: #1E293B;
    }

    /* ── ID chip ── */
    .id-chip {
        display: inline-block;
        font-size: .75rem;
        font-weight: 600;
        color: #64748B;
        background: #F1F5F9;
        border-radius: 6px;
        padding: .2rem .55rem;
        font-variant-numeric: tabular-nums;
    }

    /* ── Role badges ── */
    .roles-cell {
        display: flex;
        flex-wrap: wrap;
        gap: .35rem;
    }

    .role-badge {
        display: inline-block;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        border-radius: 20px;
        padding: .2rem .65rem;
        white-space: nowrap;
    }

    .role-badge--admin         { background: #FEF3C7; color: #92400E; }
    .role-badge--lekarz        { background: #D1FAE5; color: #065F46; }
    .role-badge--rejestratorka { background: #DBEAFE; color: #1E40AF; }
    .role-badge--pacjent       { background: #EDE9FE; color: #5B21B6; }
    .role-badge--none          { background: #F1F5F9; color: #94A3B8; }

    /* fallback for any other role name */
    .role-badge:not(.role-badge--admin):not(.role-badge--lekarz):not(.role-badge--rejestratorka):not(.role-badge--pacjent):not(.role-badge--none) {
        background: #EFF6FF;
        color: #1D4ED8;
    }

    /* ── Edit button ── */
    .td-action { text-align: right; }

    .action-group {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .action-group form {
        display: inline-flex;
        margin: 0;
    }

    .btn-edit,
    .btn-delete {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        width: 132px;
        height: 38px;
        padding: 0 .85rem;
        font-size: .8rem;
        font-weight: 600;
        border-radius: 8px;
        transition: all .18s;
        white-space: nowrap;
        cursor: pointer;
    }

    .btn-edit {
        color: #2563EB;
        background: #EFF6FF;
        border: 1.5px solid #BFDBFE;
        text-decoration: none;
    }

    .btn-edit:hover {
        background: #2563EB;
        color: #fff;
        border-color: #2563EB;
        box-shadow: 0 3px 10px rgba(37,99,235,.25);
    }

    .btn-delete {
        color: #DC2626;
        background: #FEF2F2;
        border: 1.5px solid #FECACA;
    }

    .btn-delete:hover {
        background: #DC2626;
        color: #fff;
        border-color: #DC2626;
        box-shadow: 0 3px 10px rgba(220,38,38,.25);
    }

    /* ── Empty state ── */
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .75rem;
        padding: 3.5rem 2rem;
        background: #fff;
        border: 1px dashed #D1D5DB;
        border-radius: 14px;
        color: #94A3B8;
        text-align: center;
    }

    .empty-state svg {
        width: 42px;
        height: 42px;
    }

    .empty-state p {
        font-size: .9rem;
        margin: 0;
    }

    @@media (max-width: 600px) {
        .page-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 1rem;
        }

        .filter-form {
            justify-content: flex-start;
            width: 100%;
        }

        .filter-form__select { width: 100%; }
        .user-cell__email { font-size: .8rem; }
        .data-table th, .data-table td { padding: .75rem .9rem; }
    }
</style>
