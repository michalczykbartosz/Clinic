@model List<ClinicManager.DTOs.UserRolesDto>

<table>
    <thead>
    <tr>
        <th>Email</th>
        <th>ID</th>
        <th>Role</th>
        <th>Akcja</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Email</td>
            <td>@user.Id</td>
            <td>@string.Join(", ", user.Roles)</td>
            <td>
                <a asp-action="EditRoles" asp-route-id="@user.Id">Edytuj</a>
                </td>
            
        </tr>
    }
    </tbody>
</table>