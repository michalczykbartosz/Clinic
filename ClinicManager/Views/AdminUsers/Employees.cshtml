@model List<ClinicManager.DTOs.EmployeeDto>

@{
    ViewData["Title"] = "Pracownicy";
    var totalUsersCount = ViewData["TotalUsersCount"] as int? ?? Model.Count;
}

<div class="page-wrapper">
    <div class="page-header">
        <div class="page-header__left">
            <div class="page-header__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
            </div>
            <div>
                <h1 class="page-header__title">Pracownicy</h1>
                <p class="page-header__sub">@Model.Count kont pracowniczych z @totalUsersCount użytkowników</p>
            </div>
        </div>
        <a class="btn btn-secondary" asp-action="GetRoles">Wszystkie konta</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <p>Brak kont pracowniczych w systemie.</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-scroll">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Pracownik</th>
                            <th>Imię i nazwisko</th>
                            <th>Role</th>
                            <th class="th-action">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <div class="user-cell__avatar">@(string.IsNullOrWhiteSpace(user.Email) ? "?" : user.Email[0].ToString().ToUpper())</div>
                                    <span class="user-cell__email">@user.Email</span>
                                </div>
                            </td>
                            <td>
                                <div class="person-cell">
                                    <strong>@user.FullName</strong>
                                    @if (!string.IsNullOrWhiteSpace(user.Pesel))
                                    {
                                        <span>PESEL @user.Pesel</span>
                                    }
                                </div>
                            </td>
                            <td>
                                <div class="roles-cell">
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="role-badge role-badge--@role.ToLower()">@role</span>
                                    }
                                </div>
                            </td>
                            <td class="td-action">
                                <div class="actions-cell">
                                    <a asp-action="EditRoles" asp-route-id="@user.Id" class="btn-edit">Edytuj role</a>
                                    @if (user.Roles.Contains("Lekarz"))
                                    {
                                        <a asp-controller="DoctorProfile" asp-action="EditEmployee" asp-route-userId="@user.Id" class="btn-edit btn-edit--doctor">Profil lekarza</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; }
    .page-wrapper { max-width: 1060px; margin: 2.5rem auto; padding: 0 1rem; font-family: 'Inter', system-ui, -apple-system, sans-serif; }
    .page-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.75rem; flex-wrap: wrap; }
    .page-header__left { display: flex; align-items: center; gap: 1rem; }
    .page-header__icon { width: 48px; height: 48px; background: #EFF6FF; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #2563EB; flex-shrink: 0; }
    .page-header__icon svg { width: 22px; height: 22px; }
    .page-header__title { font-size: 1.5rem; font-weight: 700; color: #0F172A; margin: 0 0 .15rem; }
    .page-header__sub { font-size: .82rem; color: #94A3B8; margin: 0; }
    .table-card { background: #fff; border: 1px solid #E2E8F0; border-radius: 14px; overflow: hidden; box-shadow: 0 1px 3px rgba(0,0,0,.05); }
    .table-scroll { overflow-x: auto; }
    .data-table { width: 100%; border-collapse: collapse; font-size: .875rem; }
    .data-table thead tr { background: #F8FAFC; }
    .data-table th { padding: .75rem 1.25rem; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .07em; color: #64748B; text-align: left; border-bottom: 1px solid #E2E8F0; white-space: nowrap; }
    .data-table td { padding: .9rem 1.25rem; border-bottom: 1px solid #F1F5F9; vertical-align: middle; }
    .data-table tbody tr:last-child td { border-bottom: none; }
    .th-action, .td-action { text-align: right; }
    .user-cell { display: flex; align-items: center; gap: .75rem; }
    .user-cell__avatar { width: 34px; height: 34px; border-radius: 50%; background: linear-gradient(135deg, #3B82F6, #6366F1); color: #fff; font-size: .8rem; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .user-cell__email { font-weight: 500; color: #1E293B; }
    .person-cell { display: grid; gap: .18rem; min-width: 150px; }
    .person-cell strong { color: #1E293B; font-weight: 650; }
    .person-cell span { color: #94A3B8; font-size: .76rem; }
    .roles-cell { display: flex; flex-wrap: wrap; gap: .35rem; }
    .actions-cell { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .4rem; }
    .role-badge { display: inline-block; font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; border-radius: 20px; padding: .2rem .65rem; white-space: nowrap; }
    .role-badge--admin { background: #FEF3C7; color: #92400E; }
    .role-badge--lekarz { background: #D1FAE5; color: #065F46; }
    .role-badge--rejestratorka { background: #DBEAFE; color: #1E40AF; }
    .role-badge--pacjent { background: #EDE9FE; color: #5B21B6; }
    .btn, .btn-secondary, .btn-edit { display: inline-flex; align-items: center; justify-content: center; gap: .45rem; font-weight: 600; border: 1.5px solid transparent; border-radius: 8px; cursor: pointer; text-decoration: none; transition: all .18s; white-space: nowrap; }
    .btn-secondary { height: 38px; padding: 0 1rem; background: #fff; color: #475569; border-color: #D1D5DB; }
    .btn-secondary:hover { background: #F8FAFC; border-color: #94A3B8; color: #1E293B; }
    .btn-edit { height: 36px; padding: 0 .85rem; color: #2563EB; background: #EFF6FF; border-color: #BFDBFE; font-size: .8rem; }
    .btn-edit:hover { background: #2563EB; color: #fff; border-color: #2563EB; }
    .btn-edit--doctor { color: #047857; background: #ECFDF5; border-color: #A7F3D0; }
    .btn-edit--doctor:hover { background: #047857; color: #fff; border-color: #047857; }
    .empty-state { padding: 3rem 2rem; background: #fff; border: 1px dashed #D1D5DB; border-radius: 14px; color: #94A3B8; text-align: center; }
    .empty-state p { margin: 0; }
</style>
