@model ClinicManager.DTOs.RegisterDto

@{
    ViewData["Title"] = "Rejestracja";
    Layout = "_Layout";
}

<div class="auth-wrapper">
    <div class="auth-shell">
        <section class="auth-panel">
            <div>
                <div class="auth-panel__icon">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
                <h1>Rejestracja pacjenta</h1>
                <p>Utw&oacute;rz konto, aby widzie&#263; swoje wizyty i ich aktualny status w panelu pacjenta.</p>
            </div>
            <div class="auth-panel__note">
                PESEL s&#322;u&#380;y do powi&#261;zania konta z kartotek&#261; pacjenta.
            </div>
        </section>

        <section class="auth-card">
            <div class="auth-card__header">
                <h2>Nowe konto</h2>
                <p>Has&#322;o powinno mie&#263; co najmniej 10 znak&oacute;w.</p>
            </div>

            <form asp-action="Register" method="post" class="auth-form">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                <div class="form-group">
                    <label asp-for="FirstName" class="form-label">Imi&#281;</label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="LastName" class="form-label">Nazwisko</label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Adres e-mail</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Pesel" class="form-label">PESEL</label>
                    <input asp-for="Pesel" class="form-control" inputmode="numeric" maxlength="11" autocomplete="off" />
                    <span asp-validation-for="Pesel" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="InsuranceNumber" class="form-label">Numer ubezpieczenia</label>
                    <input asp-for="InsuranceNumber" class="form-control" maxlength="40" autocomplete="off" />
                    <span asp-validation-for="InsuranceNumber" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BirthDate" class="form-label">Data urodzenia</label>
                    <input asp-for="BirthDate" class="form-control" type="date" autocomplete="bday" />
                    <span asp-validation-for="BirthDate" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Has&#322;o</label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PasswordConfirm" class="form-label">Powt&oacute;rz has&#322;o</label>
                    <input asp-for="PasswordConfirm" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="PasswordConfirm" class="field-error"></span>
                </div>

                <div class="auth-actions">
                    <button type="submit" class="btn btn-primary">Zarejestruj</button>
                    <a class="auth-link" asp-controller="Account" asp-action="Login">Mam ju&#380; konto</a>
                </div>
            </form>
        </section>
    </div>
</div>

@await Html.PartialAsync("_AccountFormStyles")

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
