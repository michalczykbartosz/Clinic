<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClinicManager</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicManager.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm app-navbar mb-3">
            <div class="container-fluid">
                <a class="navbar-brand app-brand" asp-area="" asp-controller="Home" asp-action="Index">ClinicManager</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav app-nav-list flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link app-nav-link @(currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Rejestratorka") || User.IsInRole("Lekarz"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(currentController == "Patients" ? "active" : "")" asp-area="" asp-controller="Patients" asp-action="Index">Pacjenci</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(currentController == "Visits" ? "active" : "")" asp-area="" asp-controller="Visits" asp-action="Index">Wizyty</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(currentController == "Schedule" ? "active" : "")" asp-area="" asp-controller="Schedule" asp-action="Index">Grafik</a>
                            </li>
                        }
                        @if (User.IsInRole("Pacjent"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(currentController == "Visits" ? "active" : "")" asp-area="" asp-controller="Visits" asp-action="Index">Przejdź do wizyt</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(currentController == "Patients" && currentAction == "MyData" ? "active" : "")" asp-area="" asp-controller="Patients" asp-action="MyData">Moje dane</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(currentAction == "Employees" ? "active" : "")" asp-area="" asp-controller="AdminUsers" asp-action="Employees">Pracownicy</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(currentController == "AdminUsers" && currentAction == "GetRoles" ? "active" : "")" asp-area="" asp-controller="AdminUsers" asp-action="GetRoles">Konta</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("Lekarz"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(currentController == "Medication" ? "active" : "")" asp-area="" asp-controller="Medication" asp-action="Index">Leki</a>
                            </li>
                        }
                        @if (User.IsInRole("Lekarz"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(currentController == "DoctorProfile" ? "active" : "")" asp-area="" asp-controller="DoctorProfile" asp-action="Edit">Mój profil</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link app-nav-link @(currentController == "Report" ? "active" : "")" asp-area="" asp-controller="Report" asp-action="Index">Raporty</a>
                            </li>
                        }
                    </ul>
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        var currentRoles = new[] { "Admin", "Lekarz", "Rejestratorka", "Pacjent" }
                            .Where(User.IsInRole)
                            .ToList();
                        var currentRoleText = currentRoles.Count == 0 ? "Brak roli" : string.Join(", ", currentRoles);

                        <ul class="navbar-nav app-user-nav">
                            <li class="nav-item d-flex align-items-center">
                                <span class="navbar-text app-user-chip">
                                    Zalogowano: <strong>@(User.Identity.Name ?? "użytkownik")</strong> (@currentRoleText)
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-action="Logout" asp-controller="Account" method="post">
                                    <button class="nav-link btn btn-link app-nav-link app-logout-link" type="submit">Wyloguj</button>
                                </form>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ClinicManager - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
