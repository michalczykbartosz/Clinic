@using ClinicManager.Models
@model ClinicManager.ViewModels.ScheduleViewModel

@{
    ViewData["Title"] = "Grafik";
}

@functions {
    private static string GetVisitStatusLabel(VisitState status)
    {
        return status switch
        {
            VisitState.Planned => "Zaplanowana",
            VisitState.InProgress => "W trakcie",
            VisitState.Finished => "Zakończona",
            VisitState.Canceled => "Anulowana",
            _ => status.ToString()
        };
    }

    private static string GetVisitStatusBadgeClass(VisitState status)
    {
        return status switch
        {
            VisitState.Planned => "status-badge--planned",
            VisitState.InProgress => "status-badge--progress",
            VisitState.Finished => "status-badge--finished",
            VisitState.Canceled => "status-badge--canceled",
            _ => "status-badge--default"
        };
    }
}

<div class="schedule-wrapper">
    <div class="page-header">
        <div class="page-header__left">
            <div class="page-header__icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                    <path d="M8 15h3"/>
                    <path d="M13 15h3"/>
                    <path d="M8 18h3"/>
                </svg>
            </div>
            <div>
                <h1 class="page-header__title">Grafik</h1>
                <p class="page-header__sub">Zaplanowane wizyty lekarza w wybranym dniu</p>
            </div>
        </div>
    </div>

    <form asp-action="Index" method="get" class="filter-card">
        <div class="form-group">
            <label asp-for="DoctorId" class="form-label">Lekarz</label>
            <select asp-for="DoctorId" asp-items="Model.Doctors" class="form-control form-select"></select>
        </div>
        <div class="form-group form-group--date">
            <label for="date" class="form-label">Dzień</label>
            <input id="date"
                   name="date"
                   type="date"
                   class="form-control"
                   value="@Model.Date.ToString("yyyy-MM-dd")" />
        </div>
        <div class="filter-actions">
            <button type="submit" class="btn btn-primary">Pokaż grafik</button>
        </div>
    </form>

    <div class="summary-card">
        <div>
            <span class="summary-label">Lekarz</span>
            <strong>@(Model.SelectedDoctor is null ? "Brak lekarzy w systemie" : $"{Model.SelectedDoctor.FirstName} {Model.SelectedDoctor.LastName}")</strong>
        </div>
        <div>
            <span class="summary-label">Data</span>
            <strong>@Model.Date.ToString("dd.MM.yyyy")</strong>
        </div>
        <div>
            <span class="summary-label">Wizyty</span>
            <strong>@Model.Visits.Count</strong>
        </div>
    </div>

    @if (Model.SelectedDoctor is null)
    {
        <div class="empty-state">
            <p>Brak lekarzy w systemie.</p>
        </div>
    }
    else if (Model.Visits.Count == 0)
    {
        <div class="empty-state">
            <p>Ten lekarz nie ma zaplanowanych wizyt w wybranym dniu.</p>
        </div>
    }
    else
    {
        <div class="table-card">
            <table class="data-table schedule-table">
                <thead>
                <tr>
                    <th>Godzina</th>
                    <th>Status</th>
                    <th>Pacjent</th>
                    <th>PESEL</th>
                    <th class="th-action">Obsługa</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var visit in Model.Visits)
                {
                    <tr>
                        <td data-label="Godzina" class="cell--time">@visit.VisitDateTime.ToString("HH:mm")</td>
                        <td data-label="Status">
                            <span class="status-badge @GetVisitStatusBadgeClass(visit.VisitStatus)">
                                @GetVisitStatusLabel(visit.VisitStatus)
                            </span>
                        </td>
                        <td data-label="Pacjent">
                            <a class="name-link"
                               asp-controller="Patients"
                               asp-action="Details"
                               asp-route-id="@visit.PatientId">
                                @visit.PatientFullName
                            </a>
                        </td>
                        <td data-label="PESEL" class="cell--muted">@visit.PatientPESEL</td>
                        <td data-label="Obsługa" class="td-action">
                            <a class="btn-mini btn-mini--secondary"
                               asp-controller="VisitMedications"
                               asp-action="Index"
                               asp-route-visitId="@visit.VisitId">
                                Leki
                            </a>
                            <a class="btn-mini btn-mini--secondary"
                               asp-controller="Procedures"
                               asp-action="Index"
                               asp-route-visitId="@visit.VisitId">
                                Procedury
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    *, *::before, *::after { box-sizing: border-box; }

    .schedule-wrapper {
        max-width: 980px;
        margin: 2.5rem auto;
        padding: 0 1rem;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: #1E293B;
    }

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
    }

    .page-header__left { display: flex; align-items: center; gap: 1rem; }

    .page-header__icon {
        width: 48px;
        height: 48px;
        background: #EFF6FF;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2563EB;
        flex-shrink: 0;
    }

    .page-header__icon svg { width: 22px; height: 22px; }
    .page-header__title { font-size: 1.5rem; font-weight: 700; color: #0F172A; margin: 0 0 .15rem; letter-spacing: -.02em; }
    .page-header__sub { font-size: .82rem; color: #94A3B8; margin: 0; }

    .filter-card {
        display: grid;
        grid-template-columns: minmax(220px, 1fr) 180px auto;
        align-items: end;
        gap: .85rem;
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        padding: 1rem;
        margin-bottom: 1rem;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
    }

    .form-group { display: flex; flex-direction: column; gap: .4rem; min-width: 0; }
    .form-label { font-size: .82rem; font-weight: 600; color: #374151; }

    .form-control {
        width: 100%;
        padding: .6rem .85rem;
        font-size: .9rem;
        color: #1E293B;
        background: #FAFAFA;
        border: 1.5px solid #D1D5DB;
        border-radius: 9px;
        transition: border-color .18s, box-shadow .18s;
        outline: none;
    }

    .form-control:focus {
        border-color: #3B82F6;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(59,130,246,.15);
    }

    .form-select {
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2394A3B8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right .75rem center;
        background-size: 16px;
        padding-right: 2.25rem;
    }

    .summary-card {
        display: grid;
        grid-template-columns: 1fr 160px 110px;
        gap: .75rem;
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        padding: 1rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 1px 3px rgba(0,0,0,.04);
    }

    .summary-card div {
        background: #F8FAFC;
        border: 1px solid #EEF2F7;
        border-radius: 10px;
        padding: .85rem;
    }

    .summary-label {
        display: block;
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #94A3B8;
        margin-bottom: .35rem;
    }

    .summary-card strong { color: #0F172A; font-size: .92rem; }

    .empty-state {
        padding: 2.75rem 2rem;
        background: #fff;
        border: 1px dashed #D1D5DB;
        border-radius: 14px;
        color: #94A3B8;
        text-align: center;
    }

    .empty-state p { margin: 0; }

    .table-card {
        background: #fff;
        border: 1px solid #E2E8F0;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(0,0,0,.05);
    }

    .data-table { width: 100%; border-collapse: collapse; font-size: .85rem; }
    .data-table thead tr { background: #F8FAFC; }
    .data-table th { padding: .75rem 1.1rem; font-size: .68rem; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: #64748B; text-align: left; border-bottom: 1px solid #E2E8F0; white-space: nowrap; }
    .data-table td { padding: .85rem 1.1rem; border-bottom: 1px solid #F1F5F9; vertical-align: middle; white-space: nowrap; }
    .data-table tbody tr:last-child td { border-bottom: none; }
    .data-table tbody tr:hover { background: #FAFBFF; }
    .th-action, .td-action { text-align: right; }
    .cell--time { color: #0F172A; font-weight: 700; font-variant-numeric: tabular-nums; }
    .cell--muted { color: #94A3B8; }
    .name-link { color: #2563EB; font-weight: 600; text-decoration: none; }
    .name-link:hover { text-decoration: underline; }

    .status-badge {
        display: inline-block;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        border-radius: 20px;
        padding: .25rem .7rem;
        white-space: nowrap;
    }

    .status-badge--planned { background: #DBEAFE; color: #1D4ED8; }
    .status-badge--progress { background: #FEF3C7; color: #92400E; }
    .status-badge--finished { background: #D1FAE5; color: #065F46; }
    .status-badge--canceled, .status-badge--default { background: #F1F5F9; color: #64748B; }

    .btn,
    .btn-mini {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        font-weight: 600;
        border: 1.5px solid transparent;
        cursor: pointer;
        text-decoration: none;
        transition: all .18s;
        font-family: inherit;
        white-space: nowrap;
    }

    .btn { padding: .6rem 1.3rem; font-size: .875rem; border-radius: 9px; }
    .btn-mini { padding: .4rem .8rem; font-size: .78rem; border-radius: 7px; }
    .btn-primary { background: #2563EB; color: #fff; border-color: #2563EB; }
    .btn-primary:hover { background: #1D4ED8; border-color: #1D4ED8; color: #fff; box-shadow: 0 4px 12px rgba(37,99,235,.3); transform: translateY(-1px); }
    .btn-mini--secondary { background: #fff; color: #475569; border-color: #D1D5DB; }
    .btn-mini--secondary:hover { background: #F8FAFC; border-color: #94A3B8; color: #1E293B; }

    @@media (max-width: 760px) {
        .filter-card,
        .summary-card {
            grid-template-columns: 1fr;
        }

        .table-card {
            background: transparent;
            border: 0;
            box-shadow: none;
            overflow: visible;
        }

        .data-table,
        .data-table thead,
        .data-table tbody,
        .data-table tr,
        .data-table th,
        .data-table td {
            display: block;
            width: 100%;
        }

        .data-table thead { display: none; }

        .data-table tr {
            background: #fff;
            border: 1px solid #E2E8F0;
            border-radius: 14px;
            box-shadow: 0 1px 3px rgba(0,0,0,.05);
            margin-bottom: .8rem;
            overflow: hidden;
        }

        .data-table td {
            display: grid;
            grid-template-columns: 95px minmax(0, 1fr);
            gap: .75rem;
            align-items: center;
            padding: .72rem .85rem;
            white-space: normal;
        }

        .data-table td::before {
            content: attr(data-label);
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #94A3B8;
        }

        .td-action { text-align: left; }
    }
</style>
